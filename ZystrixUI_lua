			FX.burst(c, Theme.Accent, 6, 28 * s, { Size = 8 * s, Squash = 0.6 })
			if o.OnComplete then task.spawn(o.OnComplete) end
		end
	end
	function obj:Get() return self.Value end

	obj:Set(o.Default or min, true)
	return obj
end

function Section:AddColorPicker(o)
