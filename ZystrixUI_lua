	local function updateTiles()
		local players, maxP = #Players:GetPlayers(), Players.MaxPlayers or 0
		tPlayers:Set(maxP > 0 and (players .. " / " .. maxP) or tostring(players), nil, true)
		if maxP > 0 then tPlayers:Fill(players / maxP) end
		local ping = win.Ping or 0
		tPing:Set(string.format("%d ms", math.floor(ping + 0.5)), ping < 100 and GOOD or ping < 200 and WARN or BAD, true)
		local fps = win.Fps or 0
		tFps:Set(string.format("%d FPS", math.floor(fps + 0.5)), fps >= 55 and GOOD or fps >= 30 and WARN or BAD, true)
		tUp:Set(clock(workspace.DistributedGameTime), nil, true)
		sessionLbl.Text = clock(os.clock() - born)
	end

	local acc, accSec, accFr, accRot = 0, 0, 0, 0
	connect(RunService.Heartbeat, function(dt)
		acc += dt
		if acc >= 0.5 then
			acc = 0
			sample()
			if tab.Active and win.Visible then
				D.render()
				updateTiles()
			end
		end
		if tab.Active and win.Visible then
			accSec += dt
			accFr += dt
			accRot += dt
			if accRot >= (IS_TOUCH and 1 / 20 or 1 / 30) then
				ringG.Rotation = (ringG.Rotation + accRot * 110) % 360
				for _, g in ipairs(glows) do g.Rotation = (g.Rotation + accRot * 14) % 360 end
				accRot = 0
			end
			if accSec >= 1 then
				accSec = 0
				sessionLbl.Text = clock(os.clock() - born)
				tUp:Set(clock(workspace.DistributedGameTime), nil, true)
			end
			if accFr >= 60 then
				accFr = 0
				loadFriends()
			end
		end
	end)

	function D.intro()
		for i, sl in ipairs(slides) do
			local f, base = sl[1], sl[2]
			f.Position = base + UDim2.fromOffset(0, 12)
			task.delay((i - 1) * 0.04, function()
				if f.Parent then tween(f, { Position = base }, 0.4, Enum.EasingStyle.Quint) end
			end)
		end
	end
	connect(tab.Page:GetPropertyChangedSignal("Visible"), function()
		if tab.Page.Visible then D.intro() end
	end)

	function D.Refresh()
		loadFriends()
		D.render()
	end

	sample()
	sample()
	D.render()
	updateTiles()
	loadFriends()
	paintPills()
	D.intro()
	return tab
end

------------------------------------------------------------------------
-- DIALOGS
-- Library:Confirm({
--   Title, Content, Icon, Tag, Type = "info"|"success"|"warning"|"error" (Danger = true == error),
--   ConfirmText, CancelText (false = single button / alert), Callback(value), OnCancel,
--   Input = { Placeholder, Default, Numeric, MaxLength, Validate = fn(text) -> ok, message },
--   Countdown = seconds before confirm unlocks (default 3 for error/danger),
--   Remember = "key" -> "Don't ask again" checkbox
-- })
-- Library:Alert({...})  one-button dialog      Library:Prompt({...})  dialog with a text field
-- Dialogs queue instead of being dropped when one is already open.
------------------------------------------------------------------------
Library._confirmQueue = {}
Library.ConfirmSkips = {}

function Library:ResetConfirmations() Library.ConfirmSkips = {} end

function Library:Alert(o)
	o = o or {}
	local c = {}
	for k, v in pairs(o) do c[k] = v end
	c.CancelText = false
	c.ConfirmText = o.ConfirmText or "OK"
	return Library:Confirm(c)
end

function Library:Prompt(o)
	o = o or {}
	local c = {}
	for k, v in pairs(o) do c[k] = v end
	c.Input = o.Input or {}
	c.Icon = o.Icon or "edit"
	c.ConfirmText = o.ConfirmText or "Submit"
	return Library:Confirm(c)
end

function Library:Confirm(o)
	o = o or {}
	if o.Remember and Library.ConfirmSkips[o.Remember] then
		if o.Callback then task.spawn(o.Callback, o.Input and (o.Input.Default or "") or true) end
		return
	end
	if Library._confirm then
		local q = Library._confirmQueue
		if #q < 6 then q[#q + 1] = o end
		return
	end
	Library._confirm = true
	closePopup()

	local W, T = 332, Kit.Thick.Dialog
	local WHITE, BLACK = Kit.White, Kit.Black
	local typeName = o.Type
	if typeName == nil and (o.Danger or o.Icon == "close" or o.Icon == "trash") then typeName = "error" end
	local color, tIcon, tLabel, isTone = Kit.tone(typeName)
	local danger = tLabel == "ERROR" and isTone
	local tone = isTone and color or nil
	local accent = color
	local icon = o.Icon or tIcon
	local PERIOD = 22
	local topH = danger and 12 or 0
	local showHints = UserInputService.KeyboardEnabled and not IS_TOUCH
	local single = o.CancelText == false
	local hasInput = type(o.Input) == "table"
	local countdown = tonumber(o.Countdown)
	if countdown == nil and danger then countdown = 3 end
	if countdown and countdown <= 0 then countdown = nil end

	local title = tostring(o.Title or "Confirm")
	local body = tostring(o.Content or "")
	local textH = 0
	if body ~= "" then
		local okS, sz = pcall(function()
			return TextService:GetTextSize(body, 12, FONT, Vector2.new(W - 40, 10000))
		end)
		textH = (okS and sz) and (math.ceil(sz.Y) + 3) or (math.ceil(#body / 46) * 15 + 3)
	end
	local tagY = topH + 18
	local titleY = tagY + 16
	local perfY = titleY + 32
	local bodyY = perfY + 16
	local cursor = textH > 0 and (bodyY + textH + 12) or (perfY + 18)
	local inputY, checkY
	if hasInput then
		inputY = cursor
		cursor += 34 + 6
	end
	local msgY = cursor - 4
	if hasInput then cursor += 12 end
	if o.Remember then
		checkY = cursor
		cursor += 26
	end
	local btnY = cursor + 6
	local H = btnY + 44 + 18

	local vp = viewport()
	local s = math.min(1, vp.X * 0.92 / W, vp.Y * 0.9 / (H + T + 24))

	local blocker = new("TextButton", {
		Name = "DialogBlocker", Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLACK, BackgroundTransparency = 1,
		ZIndex = Kit.Z.Dialog, Parent = Gui,
	})
	local surf = Kit.surface(Gui, {
		Name = "Dialog", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(W, H),
		ZIndex = Kit.Z.Dialog + 1, Radius = Kit.Radius.Dialog, Thick = T, Tone = tone, Canvas = true, Sink = true,
		Glow = danger and 0.86 or 0.82, Shadow = { Steps = 5, Step = 5, Alpha = 0.05, Offset = 12 },
	})
	local root, slab, faceBox, card, outStroke = surf.Root, surf.Base, surf.Box, surf.Face, surf.Stroke
	local shadow = surf.Shadow
	local rootScale = new("UIScale", { Scale = s * 1.16, Parent = root })
	shadow:Set(false)
	slab.BackgroundTransparency = 1
	local slabStroke = new("UIStroke", {
		Color = (tone or Theme.Stroke):Lerp(BLACK, tone and 0.45 or 0), Thickness = 1, Transparency = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = slab,
	})
	card.GroupTransparency = 1
	outStroke.Transparency = 1

	local beltTw
	if danger then
		local clip = new("Frame", {
			Size = UDim2.new(1, 0, 0, topH), BackgroundColor3 = color:Lerp(BLACK, 0.82), ClipsDescendants = true, Parent = card,
		})
		local belt = new("Frame", { Size = UDim2.new(0, W + PERIOD * 3, 1, 0), Parent = clip })
		for i = 0, math.ceil((W + PERIOD * 2) / PERIOD) do
			new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(i * PERIOD, topH / 2),
				Size = UDim2.fromOffset(9, topH * 3), Rotation = 38, BackgroundColor3 = color, Parent = belt,
			})
		end
		beltTw = TweenService:Create(belt, TweenInfo.new(1.1, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1, false), {
			Position = UDim2.fromOffset(-PERIOD, 0),
		})
		beltTw:Play()
	end

	Kit.tag(card, o.Tag or (isTone and tLabel) or (single and "Notice" or "Confirm"), tone, {
		TextSize = 11, Position = UDim2.fromOffset(20, tagY), Size = UDim2.fromOffset(W - 40 - 64, 12),
	})

	local tsize = 17
	while tsize > 12 and textWidth(title, tsize, FONT_BOLD) > W - 42 do tsize -= 1 end
	new("TextLabel", {
		Text = title, Font = FONT_BOLD, TextSize = tsize, Fg = "Text", Position = UDim2.fromOffset(20, titleY),
		Size = UDim2.fromOffset(W - 40, 22), TextTruncate = Enum.TextTruncate.AtEnd, Parent = card,
	})
	Kit.perf(card, 20, perfY, W - 40)
	if textH > 0 then
		new("TextLabel", {
			Text = body, TextSize = 12, Fg = "SubText", Position = UDim2.fromOffset(20, bodyY),
			Size = UDim2.fromOffset(W - 40, textH), TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Parent = card,
		})
	end

	local inputBox, msgLbl, inputStroke, inputWrap
	if hasInput then
		local io = o.Input
		inputWrap = new("Frame", {
			Name = "Input", Position = UDim2.fromOffset(20, inputY), Size = UDim2.fromOffset(W - 40, 34), Bg = "Element", Parent = card,
		})
		corner(inputWrap, 9)
		inputStroke = stroke(inputWrap)
		gradient(inputWrap, 205)
		inputBox = new("TextBox", {
			Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -24, 1, 0), Fg = "Text", Ph = "SubText",
			PlaceholderText = io.Placeholder or "Type here...", Text = tostring(io.Default or ""), TextSize = 13, ClipsDescendants = true,
			Parent = inputWrap,
		})
		msgLbl = new("TextLabel", {
			Position = UDim2.fromOffset(22, msgY + 38), Size = UDim2.fromOffset(W - 44, 12), TextSize = 10, TextTransparency = 1,
			TextColor3 = Kit.Tones.error.Color, Text = "", Parent = card,
		})
		inputBox:GetPropertyChangedSignal("Text"):Connect(function()
			local t = inputBox.Text
			if io.Numeric then
				local f = t:gsub("[^%d%.%-]", "")
				if f ~= t then
					inputBox.Text = f
					return
				end
			end
			if io.MaxLength and #t > io.MaxLength then inputBox.Text = t:sub(1, io.MaxLength) end
			msgLbl.TextTransparency = 1
			tween(inputStroke, { Color = inputBox:IsFocused() and accent or Theme.Stroke }, 0.15)
		end)
		inputBox.Focused:Connect(function() tween(inputStroke, { Color = accent }, 0.2) end)
		inputBox.FocusLost:Connect(function(enter)
			tween(inputStroke, { Color = Theme.Stroke }, 0.2)
			if enter and Library._confirmSubmit then Library._confirmSubmit() end
		end)
	end

	local remember = false
	if o.Remember then
		local box = new("Frame", {
			Position = UDim2.fromOffset(20, checkY + 2), Size = UDim2.fromOffset(16, 16), Bg = "Element", Parent = card,
		})
		corner(box, 5)
		local cst = stroke(box)
		local tick = makeIcon(box, "check", 11, nil, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })
		tick.ImageTransparency = 1
		tintIcon(tick, Theme.AccentText, 0.01)
		Kit.tag(card, "Don't ask again", nil, {
			Position = UDim2.fromOffset(44, checkY + 3), Size = UDim2.fromOffset(W - 64, 14), TextSize = 11, Font = FONT,
		})
		local zone = new("TextButton", { Position = UDim2.fromOffset(14, checkY - 2), Size = UDim2.fromOffset(W - 28, 24), Parent = card })
		Kit.click(zone, function()
			remember = not remember
			tween(box, { BackgroundColor3 = remember and accent or Theme.Element }, 0.15)
			tween(cst, { Color = remember and accent or Theme.Stroke }, 0.15)
			tween(tick, { ImageTransparency = remember and 0 or 1 }, 0.15)
			FX.pop(box, 1.25, 0.3)
		end, true)
	end

	local btnRow = new("Frame", { Name = "Buttons", Position = UDim2.fromOffset(0, btnY), Size = UDim2.fromOffset(W, 44), Parent = card })
	local gap = 12
	local bw = single and (W - 40) or (W - 40 - gap) / 2
	local cancel
	if not single then
		cancel = Kit.key(btnRow, {
			Text = o.CancelText or "Cancel", W = bw, H = 38, Radius = 11, Thick = 4, Variant = "neutral",
			Hint = showHints and "Esc" or nil, Position = UDim2.fromOffset(20, 0),
		})
	end
	local baseText = o.ConfirmText or (single and "OK" or "Yes")
	local okb = Kit.key(btnRow, {
		Text = baseText, W = bw, H = 38, Radius = 11, Thick = 4, Variant = "primary",
		Color = tone, Hint = (showHints and not danger) and "Enter" or nil, Position = UDim2.fromOffset(single and 20 or (20 + bw + gap), 0),
	})

	local lockUntil = countdown and (os.clock() + countdown) or nil
	local function locked() return lockUntil ~= nil and os.clock() < lockUntil end
	if lockUntil then
		okb:SetEnabled(false)
		task.spawn(function()
			while lockUntil and os.clock() < lockUntil and okb.Holder.Parent do
				okb:SetText(string.format("%s (%d)", baseText, math.ceil(lockUntil - os.clock())))
				task.wait(0.1)
			end
			if okb.Holder.Parent then
				okb:SetText(baseText)
				okb:SetEnabled(true)
				FX.pop(okb.Holder, 1.06, 0.3)
			end
		end)
	end

	local bx0, by0 = W - 46, danger and 8 or 2
	local badge = Kit.badge(root, icon, accent, 46, { Name = "Badge", Position = UDim2.fromOffset(bx0, by0), Visible = false, ZIndex = 5 })

	local closed, escCon, endCon, loopCon = false, nil, nil, nil
	local touch, mouseDown = nil, false
	local landed = false
	local drop = { x = -20, v = 0 }

	local function close(cb, value)
		if closed then return end
		closed = true
		Library._confirm = nil
		Library._confirmSubmit = nil
		lockUntil = nil
		if escCon then escCon:Disconnect() end
		if endCon then endCon:Disconnect() end
		blocker.Active = false
		card.Active = false
		if inputBox then inputBox:ReleaseFocus() end
		if beltTw then pcall(function() beltTw:Cancel() end) end
		tween(blocker, { BackgroundTransparency = 1 }, 0.2)
		task.delay(0.06, function()
			if not root.Parent then return end
			tween(card, { GroupTransparency = 1 }, 0.14)
			tween(outStroke, { Transparency = 1 }, 0.14)
			tween(slab, { BackgroundTransparency = 1 }, 0.14)
			tween(slabStroke, { Transparency = 1 }, 0.14)
			tween(root, { Position = UDim2.new(0.5, 0, 0.5, 18) }, 0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
			tween(rootScale, { Scale = s * 0.94 }, 0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
			FX.scaleTo(badge, 0.01, 0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			shadow:Fade(false, 0.16)
		end)
		task.delay(0.26, function()
			if loopCon then loopCon:Disconnect() end
			pcall(function() blocker:Destroy() end)
			pcall(function() root:Destroy() end)
			prune()
		end)
		if cb then task.spawn(cb, value) end
		task.delay(0.3, function()
			if Library._confirm then return end
			local nextO = table.remove(Library._confirmQueue, 1)
			if nextO then Library:Confirm(nextO) end
		end)
	end

	local function submit()
		if closed then return end
		if locked() then
			FX.pop(okb.Holder, 0.96, 0.25)
			return
		end
		local value = true
		if hasInput then
			local io = o.Input
			local v = inputBox.Text
			if io.Validate then
				local okV, msg = io.Validate(v)
				if not okV then
					msgLbl.Text = tostring(msg or "Invalid value")
					tween(msgLbl, { TextTransparency = 0 }, 0.15)
					tween(inputStroke, { Color = Kit.Tones.error.Color }, 0.15)
					for k, dx in ipairs({ -4, 3, -2, 0 }) do
						task.delay((k - 1) * 0.04, function()
							if not closed and inputWrap.Parent then
								inputWrap.Position = UDim2.fromOffset(20 + dx, inputY)
							end
						end)
					end
					return
				end
			end
			if io.Numeric then v = tonumber(v) or v end
			value = v
		end
		if remember and o.Remember then Library.ConfirmSkips[o.Remember] = true end
		close(o.Callback, value)
	end
	Library._confirmSubmit = submit

	local function inside(pos)
		local ap, as = root.AbsolutePosition, root.AbsoluteSize
		return pos.X >= ap.X and pos.X <= ap.X + as.X and pos.Y >= ap.Y and pos.Y <= ap.Y + as.Y
	end

	escCon = UserInputService.InputBegan:Connect(function(i)
		local kc = i.KeyCode
		if kc == Enum.KeyCode.Escape then
			close(o.OnCancel)
			return
		end
		if (kc == Enum.KeyCode.Return or kc == Enum.KeyCode.KeypadEnter) and not danger and not UserInputService:GetFocusedTextBox() then
			submit()
			return
		end
		local ty = i.UserInputType
		if ty == Enum.UserInputType.Touch then
			if inside(toScreen(i.Position)) then touch = i end
		elseif ty == Enum.UserInputType.MouseButton1 then
			if inside(toScreen(i.Position)) then mouseDown = true end
		end
	end)
	endCon = UserInputService.InputEnded:Connect(function(i)
		if i == touch then touch = nil end
		if i.UserInputType == Enum.UserInputType.MouseButton1 then mouseDown = false end
	end)

	Kit.click(blocker, function()
		if single then return end
		close(o.OnCancel)
	end)
	if cancel then
		cancel:OnClick(function() close(o.OnCancel) end)
	end
	okb:OnClick(function() submit() end)

	local px, py, near, press = { x = 0, v = 0 }, { x = 0, v = 0 }, { x = 0, v = 0 }, { x = 0, v = 0 }
	local t0 = os.clock()
	local L = {}
	local function chg(k, v, eps)
		local old = L[k]
		if old == nil or math.abs(v - old) >= eps then
			L[k] = v
			return true
		end
		return false
	end
	local function step(sp, target, dt, k, d)
		sp.v += ((target - sp.x) * k - sp.v * d) * dt
		sp.x += sp.v * dt
	end
	local function aim(x, y, cx, cy, as)
		local dx, dy = (x - cx) / (as.X * 0.7), (y - cy) / (as.Y * 0.7)
		local fade = 1 - math.clamp((math.max(math.abs(dx), math.abs(dy)) - 1.4) / 2, 0, 1)
		return math.clamp(dx, -1, 1) * fade, math.clamp(dy, -1, 1) * fade
	end

	loopCon = RunService.RenderStepped:Connect(function(dt)
		if not root.Parent then
			loopCon:Disconnect()
			return
		end
		dt = math.min(dt, 1 / 20)
		local t = os.clock() - t0
		local ap, as = root.AbsolutePosition, root.AbsoluteSize
		local cx, cy = ap.X + as.X / 2, ap.Y + as.Y / 2

		local tx, ty, nr = 0, 0, 0
		if not closed and as.X > 0 and as.Y > 0 then
			if touch then
				local tp = toScreen(touch.Position)
				tx, ty = aim(tp.X, tp.Y, cx, cy, as)
				nr = 1
			elseif not IS_TOUCH then
				local m = UserInputService:GetMouseLocation()
				tx, ty = aim(m.X, m.Y, cx, cy, as)
				nr = inside(m) and 1 or 0
			end
		end
		if inputBox and inputBox:IsFocused() then tx, ty, nr = 0, 0, 0 end

		step(px, tx, dt, 150, 16)
		step(py, ty, dt, 150, 16)
		step(near, nr, dt, 120, 14)
		step(press, (mouseDown or touch) and 1 or 0, dt, 220, 16)
		step(drop, closed and 7 or (landed and 0 or -20), dt, 190, 11)

		local bob = math.sin(t * 1.7)

		local fx = snap(-px.x * 2.5, 0.5)
		local fy = snap(-py.x * 2 - near.x * 2 + press.x * 2 + drop.x, 0.5)
		local c1, c2 = chg("fx", fx, 0.2), chg("fy", fy, 0.2)
		if c1 or c2 then faceBox.Position = UDim2.fromOffset(fx, fy) end

		local slx, sly = snap(px.x * 3.5, 0.5), T + snap(py.x * 2.5, 0.5)
		local s1, s2 = chg("slx", slx, 0.2), chg("sly", sly, 0.2)
		if s1 or s2 then slab.Position = UDim2.fromOffset(slx, sly) end

		local bdx = bx0 + snap(-px.x * 5, 0.5)
		local bdy = by0 + snap(-py.x * 3.5 + drop.x * 1.3 + bob * 1.6, 0.5)
		local b1, b2 = chg("bdx", bdx, 0.2), chg("bdy", bdy, 0.2)
		if b1 or b2 then badge.Position = UDim2.fromOffset(bdx, bdy) end

		local kx, ky = snap(-px.x * 1.2, 0.5), btnY + snap(-py.x * 1, 0.5)
		local k1, k2 = chg("kx", kx, 0.2), chg("ky", ky, 0.2)
		if k1 or k2 then btnRow.Position = UDim2.fromOffset(kx, ky) end

		local shx, shy = -px.x * 9, 12 + near.x * 3 - py.x * 9 + drop.x * 0.4
		local h1, h2 = chg("shx", shx, 0.05), chg("shy", shy, 0.05)
		if h1 or h2 then shadow.Holder.Position = UDim2.new(0.5, shx, 0.5, shy) end
	end)

	root.Rotation = -2.5
	tween(blocker, { BackgroundTransparency = 0.5 }, 0.25)
	tween(rootScale, { Scale = s }, 0.42, Enum.EasingStyle.Quint)
	tween(root, { Rotation = 0 }, 0.42, Enum.EasingStyle.Quint)
	tween(card, { GroupTransparency = 0 }, 0.2)
	tween(outStroke, { Transparency = 0 }, 0.25)
	tween(slab, { BackgroundTransparency = 0 }, 0.25)
	tween(slabStroke, { Transparency = 0 }, 0.25)
	shadow:Fade(true, 0.4)

	task.delay(0.2, function()
		if closed then return end
		landed = true
		if danger then
			for k, dx in ipairs({ -5, 4, -3, 2, 0 }) do
				task.delay((k - 1) * 0.04, function()
					if not closed and root.Parent then
						tween(root, { Position = UDim2.new(0.5, dx, 0.5, 0) }, 0.04, Enum.EasingStyle.Quad)
					end
				end)
			end
		end
	end)
	task.delay(0.24, function()
		if closed or not badge.Parent then return end
		badge.Visible = true
		badge.Rotation = -35
		tween(badge, { Rotation = 0 }, 0.55, Enum.EasingStyle.Back)
		FX.pop(badge, 0.2, 0.55)
	end)
	if inputBox then
		task.delay(0.35, function()
			if not closed and inputBox.Parent then inputBox:CaptureFocus() end
		end)
	end
end

function Window:RequestClose()
	Library:Confirm({
		Title = "Close UI?",
		Content = "The UI will be closed completely, not just hidden. Settings that were not saved to a config will be lost, and you will need to run the script again to reopen it.\n\nWant to hide it instead? Press Cancel, then press "
			.. self.ToggleKey.Name .. " or the bar at the top.",
		ConfirmText = "Close UI",
		CancelText = "Cancel",
		Icon = "close",
		Danger = true,
		Countdown = 0,
		Callback = function() Library:Unload() end,
	})
end

function Window:Destroy() Library:Unload() end

function Window:_clearBackground()
	if self._bgLayer then
		pcall(function() self._bgLayer:Destroy() end)
		self._bgLayer = nil
	end
	local dead = {}
	for _, tw in ipairs(self._bgTweens or {}) do
		dead[tw] = true
		pcall(function() tw:Cancel() end)
	end
	for i = #self._loops, 1, -1 do
		if dead[self._loops[i]] then table.remove(self._loops, i) end
	end
	self._bgTweens, self._bgItems = {}, {}
end

function Window:_bgTrack(tw)
	self._bgTweens[#self._bgTweens + 1] = tw
	self._loops[#self._loops + 1] = tw
	if not self.Visible or self.Minimized then pcall(function() tw:Pause() end) end
	return tw
end

function Window:_bgLoop(obj, props, time, style, dir, reverses)
	local tw = TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Sine, dir or Enum.EasingDirection.InOut, -1, reverses ~= false), props)
	tw:Play()
	return self:_bgTrack(tw)
end

function Window:_bgAdd(inst, prop, base, col)
	local it = { inst = inst, prop = prop, base = base, col = col }
	self._bgItems[#self._bgItems + 1] = it
	inst[prop] = 1 - math.clamp(base * (Library.Background.Intensity or 1), 0, 1)
	if col then
		local cp = (prop == "ImageTransparency") and "ImageColor3" or "BackgroundColor3"
		it.colorProp = cp
		inst[cp] = col()
	end
	return it
end

function Window:_bgIntensity()
	local k = Library.Background.Intensity or 1
	for _, it in ipairs(self._bgItems or {}) do
		if it.inst.Parent then
			it.inst[it.prop] = 1 - math.clamp(it.base * k, 0, 1)
		end
	end
end

function Window:_bgRecolor()
	for _, it in ipairs(self._bgItems or {}) do
		if it.col and it.inst.Parent then
			pcall(function() it.inst[it.colorProp] = it.col() end)
		end
	end
end

function Window:_applyBackground()
	if not self.Body then return end
	self:_clearBackground()
	local name = Library.Background.Name
	if name == "None" or not name then return end

	local W, H = BASE_W, BASE_H - HEADER_H - 1
	local layer = new("Frame", { Name = "Backdrop", Size = UDim2.fromScale(1, 1), ClipsDescendants = true, ZIndex = 0, Active = false, Parent = self.Body })
	self._bgLayer = layer

	if name == "Aurora" then
		local glow = FX.Assets.glow
		local function blob(w, h, x0, y0, x1, y1, base, col, time)
			local b
			if glow then
				b = new("ImageLabel", { Image = glow, ScaleType = Enum.ScaleType.Stretch })
			else
				b = new("Frame")
				round(b)
			end
			b.AnchorPoint = Vector2.new(0.5, 0.5)
			b.Size = UDim2.fromOffset(w, h)
			b.Position = UDim2.fromScale(x0, y0)
			b.ZIndex = 0
			b.Parent = layer
			self:_bgAdd(b, glow and "ImageTransparency" or "BackgroundTransparency", base, col)
			self:_bgLoop(b, { Position = UDim2.fromScale(x1, y1) }, time)
		end
		local function teal() return Theme.Accent:Lerp(Color3.fromRGB(40, 200, 190), 0.55) end
		local function lime() return Theme.Accent:Lerp(Color3.fromRGB(190, 255, 90), 0.4) end
		local function acc() return Theme.Accent end
		blob(460, 320, 0.30, 0.15, 0.55, 0.40, 0.34, acc, 9)
		blob(400, 300, 0.85, 0.90, 0.60, 0.62, 0.30, teal, 12)
		blob(320, 240, 0.65, 0.05, 0.92, 0.30, 0.26, lime, 15)
	elseif name == "Grid" then
		local cell = 28
		local cols, rows = math.ceil(W / cell) + 2, math.ceil(H / cell) + 2
		local grid = new("Frame", { Size = UDim2.fromOffset(cols * cell, rows * cell), Position = UDim2.fromOffset(-cell, -cell), ZIndex = 0, Parent = layer })
		local function stk() return Theme.Stroke:Lerp(Theme.Accent, 0.18) end
		for i = 0, cols do
			local l = new("Frame", { Position = UDim2.fromOffset(i * cell, 0), Size = UDim2.new(0, 1, 1, 0), ZIndex = 0, Parent = grid })
			self:_bgAdd(l, "BackgroundTransparency", 0.7, stk)
		end
		for j = 0, rows do
			local l = new("Frame", { Position = UDim2.fromOffset(0, j * cell), Size = UDim2.new(1, 0, 0, 1), ZIndex = 0, Parent = grid })
			self:_bgAdd(l, "BackgroundTransparency", 0.7, stk)
		end
		self:_bgLoop(grid, { Position = UDim2.fromOffset(0, 0) }, 3.5, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, false)
	elseif name == "Particles" then
		local n = IS_TOUCH and 8 or 16
		for _ = 1, n do
			local sz = math.random(3, 7)
			local x, y0 = math.random(), math.random()
			local p = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(sz, sz), Position = UDim2.fromScale(x, y0), ZIndex = 0, Parent = layer })
			round(p)
			self:_bgAdd(p, "BackgroundTransparency", 0.28 + math.random() * 0.3, function() return Theme.Accent end)
			local dur = 9 + math.random() * 9
			local first = TweenService:Create(p, TweenInfo.new(dur * (y0 + 0.05) / 1.1, Enum.EasingStyle.Linear), { Position = UDim2.fromScale(x, -0.05) })
			first:Play()
			self:_bgTrack(first)
			first.Completed:Connect(function(state)
				for i = #self._loops, 1, -1 do
					if self._loops[i] == first then table.remove(self._loops, i) break end
				end
				if state ~= Enum.PlaybackState.Completed or not p.Parent then return end
				p.Position = UDim2.fromScale(x, 1.05)
				self:_bgLoop(p, { Position = UDim2.fromScale(x, -0.05) }, dur, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, false)
			end)
		end
	end
end

function Library:SetBackground(name)
	if not table.find(Library.BackgroundList, name) then return end
	Library.Background.Name = name
	for _, w in ipairs(Library.Windows) do
		if w._applyBackground then pcall(w._applyBackground, w) end
	end
end

function Library:SetBackgroundIntensity(v)
	Library.Background.Intensity = math.clamp(tonumber(v) or 1, 0, 3)
	for _, w in ipairs(Library.Windows) do
		if w._bgIntensity then pcall(w._bgIntensity, w) end
	end
end

