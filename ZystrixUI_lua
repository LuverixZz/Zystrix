	corner(clr, 6)
	stroke(clr)
	makeIcon(clr, "trash", 12, "SubText", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })
	local clrHit = hitZone(clr, { ZIndex = 4 })

