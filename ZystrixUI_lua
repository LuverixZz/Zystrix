			ty = math.clamp((p.Y - (ap.Y + as.Y / 2)) / (as.Y / 2), -1, 1)
		end

		connect(RunService.Heartbeat, function(dt)
			if not holder.Visible then return end
			if pressT == 1 and not dragged and (holder.AbsolutePosition - pressAbs).Magnitude > 3 then
				dragged = true
				pressT = 0
			end
			local a = 1 - math.exp(-dt * 14)
			cx += (tx - cx) * a
			cy += (ty - cy) * a
			ph += ((hov and 1 or 0) - ph) * a
			pp += (pressT - pp) * (1 - math.exp(-dt * 26))
			local t = os.clock()
			root.Position = UDim2.new(0.5, 0, 0.5, math.sin(t * 2.1) * 1.6 * (1 - pp))
			local fy = -2.5 * ph + (THK - 1) * pp + cy * 1.2 * ph
			face.Position = UDim2.fromOffset(cx * 4.5 * ph, fy)
			for i, f in ipairs(ext) do
				local k = 1 - i / 3
				f.Position = UDim2.fromOffset(cx * 4.5 * ph * k, (i * THK / 3) * (1 + 0.4 * ph) * (1 - 0.75 * pp))
			end
			faceGrad.Rotation = 215 + cx * 28
		end)

		local appearTok = 0
		local function sync(open, instant)
			appearTok += 1
			local my = appearTok
			if open then
				if instant then
					holder.Visible = false
					return
				end
				tween(stage, { GroupTransparency = 1 }, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				tween(stScale, { Scale = 0.55 }, 0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
				tween(shScale, { Scale = 0.55 }, 0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
				tween(stage, { Position = UDim2.fromOffset(0, -18) }, 0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
				sh:Fade(false, 0.18)
				task.delay(0.25, function()
					if appearTok == my then
						holder.Visible = false
						stage.Position = UDim2.new()
					end
				end)
				return
			end
			holder.Visible = true
			hov, tx, ty, pressT = false, 0, 0, 0
			if instant then
				stage.GroupTransparency, stScale.Scale, shScale.Scale = 0, 1, 1
				stage.Position = UDim2.new()
				sh:Set(true)
				return
			end
			stage.GroupTransparency = 1
			stScale.Scale, shScale.Scale = 0.45, 0.45
			stage.Position = UDim2.fromOffset(0, -46)
			sh:Set(false)
			tween(stage, { GroupTransparency = 0 }, 0.28, Enum.EasingStyle.Quad)
			tween(stage, { Position = UDim2.new() }, 0.7, Enum.EasingStyle.Bounce)
			tween(stScale, { Scale = 1 }, 0.6, Enum.EasingStyle.Back)
			tween(shScale, { Scale = 1 }, 0.6, Enum.EasingStyle.Back)
			sh:Fade(true, 0.5)
			crown.Rotation = -180
			tween(crown, { Rotation = 0 }, 0.7, Enum.EasingStyle.Back)
			task.delay(0.32, function()
				if appearTok == my and face.Parent then
					FX.ripple(face, nil, Theme.Accent, { Radius = 12, Alpha = 0.8, Time = 0.6 })
				end
			end)
		end
		sync(self.Visible, true)
		self._pillSync = function(open) sync(open) end

		local hit = hitZone(holder, {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(PW, PHT), ZIndex = 6,
		})
		onHover(hit,
			function() hov = true end,
			function() hov = false tx, ty = 0, 0 end)
		connect(UserInputService.InputChanged, function(i)
			if hov and i.UserInputType == Enum.UserInputType.MouseMovement then aim(i.Position) end
		end)
		connect(hit.InputBegan, function(i)
			if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
				aim(i.Position)
				hov = true
			end
		end)
		connect(hit.MouseButton1Down, function()
			dragged = false
			pressAbs = holder.AbsolutePosition
			pressT = 1
		end)
		connect(hit.MouseButton1Up, function()
			pressT = 0
			dragged = false
			if IS_TOUCH then
				hov, tx, ty = false, 0, 0
			end
		end)
		connect(hit.MouseLeave, function() if not dragged then pressT = 0 end end)
		draggable(hit, holder, function()
			pressT = 0
			FX.ripple(face, nil, Theme.Accent, { Radius = 12, Alpha = 0.78, Time = 0.55 })
			tween(crown, { Rotation = 360 }, 0.5, Enum.EasingStyle.Quint)
			task.delay(0.55, function()
				if crown.Parent then crown.Rotation = 0 end
			end)
			if self.Minimized then self:SetMinimized(false) end
			self:Toggle(true)
		end)
	end

	connect(UserInputService.InputBegan, function(i, gp)
		if i.UserInputType ~= Enum.UserInputType.Keyboard then return end
		if Library.Listening then return end
		if i.KeyCode == Enum.KeyCode.K and (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)) then
			if not self.Visible then self:Toggle(true) end
			if self.Minimized then self:SetMinimized(false) end
			task.defer(function()
				sbox:CaptureFocus()
				task.wait()
				sbox.Text = ""
			end)
			return
		end
		if sbox:IsFocused() then
			local kc = i.KeyCode
			if kc == Enum.KeyCode.Down then
				self:_moveSel(1)
			elseif kc == Enum.KeyCode.Up then
				self:_moveSel(-1)
			elseif kc == Enum.KeyCode.Escape then
				self:ClearSearch()
				sbox:ReleaseFocus()
			end
			return
		end
		if not gp and i.KeyCode == self.ToggleKey then self:Toggle() end
	end)

	local cam = workspace.CurrentCamera
	if cam then
		local rtok = 0
		local function rescale()
			rtok += 1
			local my = rtok
			task.delay(0.35, function()
				if my ~= rtok or not Main.Parent or not self.Visible then return end
				if UserInputService:GetFocusedTextBox() then return end
				local goal = self.Maximized and maxScale() or fitScale()
				if math.abs(ScaleObj.Scale - goal) > 0.004 then
					tween(ScaleObj, { Scale = goal }, 0.25, Enum.EasingStyle.Quint)
				end
			end)
		end
		connect(cam:GetPropertyChangedSignal("ViewportSize"), rescale)
		connect(UserInputService.TextBoxFocusReleased, rescale)
	end

	local acc, frames = 0, 0
	connect(RunService.Heartbeat, function(dt)
		acc += dt
		frames += 1
		if acc >= 0.5 then
			self.Fps = frames / acc
			acc, frames = 0, 0
			local ok, ping = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
			self.Ping = ok and ping or 0
			if self.ShowFPS or self.ShowPing then self:_statsRefresh() end
		end
	end)

	self:_init3D(headerCrown)

	Canvas.GroupTransparency = 1
	tween(Canvas, { GroupTransparency = 0 }, 0.3, Enum.EasingStyle.Quad)

	table.insert(Library.Windows, self)
	return self
end

do
	local Motion = {
		Tilt = true, Wave = true, Depth = true,
		Gyro = true, InvertGyro = false, Strength = 1,
	}
	Library.Motion = Motion

	function Library:SetMotion(key, value)
		Motion[key] = value
	end

	local KP = NumberSequenceKeypoint.new
	local PLATES = IS_TOUCH and 2 or 3
	local IDLE_STEP = IS_TOUCH and 1 / 24 or 1 / 30

	local function spring(s, target, dt, k, d)
		s.v += ((target - s.x) * k - s.v * d) * dt
		s.x += s.v * dt
	end

	local function sat(x)
		return math.clamp(x, -1, 1)
	end

	local function aim(x, y, cx, cy, as)
		local dx, dy = (x - cx) / (as.X * 0.6), (y - cy) / (as.Y * 0.6)
		local fade = 1 - math.clamp((math.max(math.abs(dx), math.abs(dy)) - 1) / 1.2, 0, 1)
		return sat(dx) * fade, sat(dy) * fade
	end

	function Window:_init3D(headerCrown)
		local main = self.Main
		local outline = main:FindFirstChild("Outline")
		local crownTile = headerCrown and headerCrown.Parent
		self.FxShow = self.Visible ~= false

		local tilt = new("Frame", {
			Name = "Tilt", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(1, 1), Parent = main,
		})

		local shadowHolder = self.Shadow and self.Shadow.Holder
		if shadowHolder then shadowHolder.Parent = tilt end

		local plates = {}
		for k = 1, PLATES do
			local f = new("Frame", {
				Name = "Plate" .. k, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.new(1, -k * 2, 1, -k * 2), Bg = "Card", BackgroundTransparency = 1, ZIndex = 0, Parent = tilt,
			})
			corner(f, 12)
			local pst = stroke(f, "Stroke", 1)
			pst.Transparency = 1
			plates[k] = { Frame = f, Stroke = pst, Base = 0.2 + k * 0.2 }
		end

		self.Canvas.Parent = tilt
		if outline then outline.Parent = tilt end
		self.Ctrls.Parent = tilt

		local glare, glareGrad, rimStroke, rimGrad
		if outline then
			glare = new("Frame", {
				Name = "Glare", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1),
				BackgroundTransparency = 1, Active = false, Parent = outline,
			})
			corner(glare, 12)
			glareGrad = new("UIGradient", {
				Rotation = 28,
				Transparency = NumberSequence.new({ KP(0, 1), KP(0.25, 0.985), KP(0.5, 0.93), KP(0.75, 0.985), KP(1, 1) }),
				Parent = glare,
			})
			local rim = new("Frame", { Name = "Rim", Size = UDim2.fromScale(1, 1), Active = false, Parent = outline })
			corner(rim, 12)
			rimStroke = stroke(rim, "Accent", 1)
			rimStroke.Transparency = 1
			rimGrad = new("UIGradient", {
				Transparency = NumberSequence.new({ KP(0, 1), KP(0.5, 1), KP(0.8, 0.45), KP(0.95, 0.1), KP(1, 0.1) }),
				Parent = rimStroke,
			})
		end

		local px, py, lift, press = { x = 0, v = 0 }, { x = 0, v = 0 }, { x = 0, v = 0 }, { x = 0, v = 0 }
		local st = {
			show = 1, calm = 1, acc = 0, parked = false, cfg = -1, t0 = os.clock(),
			touch = nil, down = false, lcx = nil, lcy = nil, base = nil,
		}

		local function inside(p)
			local ap, as = main.AbsolutePosition, main.AbsoluteSize
			return p.X >= ap.X and p.X <= ap.X + as.X and p.Y >= ap.Y and p.Y <= ap.Y + as.Y
		end

		connect(UserInputService.InputBegan, function(i)
			if not self.FxShow then return end
			local ty = i.UserInputType
			if ty == Enum.UserInputType.Touch then
				if inside(toScreen(i.Position)) then st.touch = i end
			elseif ty == Enum.UserInputType.MouseButton1 then
				if inside(toScreen(i.Position)) then st.down = true end
			end
		end)
		connect(UserInputService.InputEnded, function(i)
			if i == st.touch then st.touch = nil end
			if i.UserInputType == Enum.UserInputType.MouseButton1 then st.down = false end
		end)

		local function gyro(dt)
			if not (Motion.Gyro and UserInputService.GyroscopeEnabled) then return 0, 0 end
			local ok, _, cf = pcall(UserInputService.GetDeviceRotation, UserInputService)
			if not ok or typeof(cf) ~= "CFrame" then return 0, 0 end
			st.base = st.base or cf
			st.base = st.base:Lerp(cf, math.min(1, dt * 0.6))
			local rx, ry = (st.base:Inverse() * cf):ToEulerAnglesXYZ()
			local sign = Motion.InvertGyro and -1 or 1
			return sat(ry / 0.3) * sign, sat(-rx / 0.3) * sign
		end

		local L = {}
		local function chg(k, v, eps)
			local o = L[k]
			if o == nil or math.abs(v - o) >= eps then
				L[k] = v
				return true
			end
			return false
		end

		connect(RunService.RenderStepped, function(rawDt)
			local goal = self.FxShow and 1 or 0
			if not main.Visible or (goal == 0 and st.show < 0.01) then
				st.lcx = nil
				return
			end
			local touch = st.touch
			if touch and (touch.UserInputState == Enum.UserInputState.End or touch.UserInputState == Enum.UserInputState.Cancel) then
				st.touch = nil
				touch = nil
			end

			local S = Motion.Strength
			local wave = Motion.Wave and 1 or 0
			local cfg = (Motion.Depth and 1 or 0) + (Motion.Tilt and 2 or 0) + Library.Transparency * 7 + S * 13
			if cfg ~= st.cfg then
				st.cfg = cfg
				st.parked = false
			end

			local ap, as = main.AbsolutePosition, main.AbsoluteSize
			local cx, cy = ap.X + as.X * 0.5, ap.Y + as.Y * 0.5
			local typing = UserInputService:GetFocusedTextBox() ~= nil
			local still = (SliderLock.Active or Library.OpenPopup or Library._confirm or typing) and 0 or 1

			local tx, ty, near = 0, 0, 0
			if still == 1 and Motion.Tilt and as.X > 0 and as.Y > 0 then
				if touch then
					local p = toScreen(touch.Position)
					tx, ty = aim(p.X, p.Y, cx, cy, as)
					near = 1
				elseif not IS_TOUCH then
					local m = UserInputService:GetMouseLocation()
					tx, ty = aim(m.X, m.Y, cx, cy, as)
					if m.X >= ap.X and m.X <= ap.X + as.X and m.Y >= ap.Y and m.Y <= ap.Y + as.Y then near = 1 end
				else
					tx, ty = gyro(rawDt)
				end
			end

			local swx, swy = 0, 0
			if st.lcx and still == 1 and Motion.Tilt and rawDt > 0 then
				local k = 1 / (math.max(rawDt, 1e-3) * 1800)
				swx = sat(-(cx - st.lcx) * k)
				swy = sat(-(cy - st.lcy) * k)
			end
			st.lcx, st.lcy = cx, cy

			local pressing = (st.down or touch ~= nil) and 1 or 0
			local moving = math.abs(px.x) + math.abs(py.x) + math.abs(px.v) + math.abs(py.v) + math.abs(lift.x) + math.abs(press.x) > 0.004
			local active = near > 0 or pressing > 0 or moving
				or math.abs(tx) + math.abs(ty) > 0.01 or math.abs(swx) + math.abs(swy) > 0.02
				or math.abs(goal - st.show) > 0.003 or math.abs(st.calm - still) > 0.01

			st.acc += rawDt
			if not active then
				if wave == 0 then
					if st.parked then
						st.acc = 0
						return
					end
				elseif st.acc < IDLE_STEP then
					return
				end
			end
			local dt = math.min(st.acc, 1 / 20)
			st.acc = 0

			local n = dt > 0.03 and 2 or 1
			local h = dt / n
			local gx, gy = sat(tx + swx * 0.9), sat(ty + swy * 0.9)
			for _ = 1, n do
				spring(px, gx, h, 140, 16)
				spring(py, gy, h, 140, 16)
				spring(lift, near, h, 120, 14)
				spring(press, pressing, h, 220, 16)
			end
			if gx == 0 and math.abs(px.x) < 0.0015 and math.abs(px.v) < 0.003 then px.x, px.v = 0, 0 end
			if gy == 0 and math.abs(py.x) < 0.0015 and math.abs(py.v) < 0.003 then py.x, py.v = 0, 0 end
			if near == 0 and math.abs(lift.x) < 0.0015 and math.abs(lift.v) < 0.003 then lift.x, lift.v = 0, 0 end
			if pressing == 0 and math.abs(press.x) < 0.0015 and math.abs(press.v) < 0.003 then press.x, press.v = 0, 0 end

			st.show += (goal - st.show) * math.min(1, dt * 12)
			st.calm += (still - st.calm) * math.min(1, dt * 9)
			local show, calm = st.show, st.calm
			local t = os.clock() - st.t0

			local amp = S * (IS_TOUCH and 0.8 or 1)
			local RX, RY = px.x * amp * calm, py.x * amp * calm
			local lf, pr = lift.x * calm, press.x * calm

			local tpx, tpy = snap(RX * 4, 0.5), snap(RY * 3 + pr * 1.5, 0.5)
			local c1, c2 = chg("tpx", tpx, 0.2), chg("tpy", tpy, 0.2)
			if c1 or c2 then tilt.Position = UDim2.new(0.5, tpx, 0.5, tpy) end

			local wx = (math.sin(t * 0.9) + 0.45 * math.sin(t * 1.9 + 1.3)) * 0.7 * wave
			local wy = (math.cos(t * 0.75 + 0.6) + 0.45 * math.sin(t * 1.5 + 2.1)) * 0.7 * wave
			local bob = (math.sin(t * 1.15) + 0.35 * math.sin(t * 2.3 + 0.8)) * wave
			local qx, qy = RX + wx * 0.3 * S * calm, RY + wy * 0.3 * S * calm

			if shadowHolder then
				local sx, sy = -qx * 9, 5 + lf * 4 - pr * 2 - qy * 9 - bob * 1.6 * calm
				local s1, s2 = chg("shx", sx, 0.05), chg("shy", sy, 0.05)
				if s1 or s2 then shadowHolder.Position = UDim2.new(0.5, sx, 0.5, sy) end
			end

			local a = show * (Motion.Depth and 1 or 0) * (1 - math.clamp((Library.Transparency - 0.1) * 1.4, 0, 0.9))
			local aChanged = chg("plA", a, 0.004)
			for k, pl in ipairs(plates) do
				local plx, ply = snap(-qx * k * 2.4, 0.25), snap(-qy * k * 2.4 + k * 0.5, 0.25)
				local p1, p2 = chg("plx" .. k, plx, 0.1), chg("ply" .. k, ply, 0.1)
				if p1 or p2 then pl.Frame.Position = UDim2.new(0.5, plx, 0.5, ply) end
				if aChanged then
					pl.Frame.BackgroundTransparency = 1 - (1 - pl.Base) * a
					pl.Stroke.Transparency = 1 - 0.6 * a * (1 - (k - 1) * 0.2)
				end
			end

			if glare then
				local go = math.clamp(qx * 0.55 + qy * 0.2, -0.85, 0.85)
				if chg("glo", go, 0.004) then glareGrad.Offset = Vector2.new(go, 0) end
				local gt = 1 - show * (0.55 + 0.45 * math.clamp(lf, 0, 1))
				if chg("glt", gt, 0.003) then glare.BackgroundTransparency = gt end
				local rr = math.deg(math.atan2(qy, qx))
				if chg("rimr", rr, 0.5) then rimGrad.Rotation = rr end
				local mag = math.min(1, math.sqrt(qx * qx + qy * qy))
				local rt = 1 - math.clamp(0.12 + mag * 0.6, 0, 1) * show
				if chg("rimt", rt, 0.004) then rimStroke.Transparency = rt end
			end

			local IX, IY = RX * 2.4, RY * 2.4
			if crownTile then
				local ix, iy = snap(IX, 0.5), snap(IY, 0.5)
				local k1, k2 = chg("crx", ix, 0.2), chg("cry", iy, 0.2)
				if k1 or k2 then crownTile.Position = UDim2.new(0, 12 + ix, 0.5, iy) end
			end
			if self.TitleBlock then
				local ix, iy = snap(IX * 0.5, 0.5), snap(IY * 0.5, 0.5)
				local k1, k2 = chg("ttx", ix, 0.2), chg("tty", iy, 0.2)
				if k1 or k2 then self.TitleBlock.Position = UDim2.fromOffset(TITLE_X + ix, iy) end
			end
			if self.UserCard then
				local ix, iy = snap(IX * 0.67, 0.5), snap(IY * 0.67, 0.5)
				local k1, k2 = chg("ucx", ix, 0.2), chg("ucy", iy, 0.2)
				if k1 or k2 then self.UserCard.Position = UDim2.new(0, 8 + ix, 1, -8 + iy) end
			end

			st.parked = (not active) and wave == 0
		end)
	end
end

