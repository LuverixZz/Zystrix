local function fxShape(name, parent)
	local asset = FX.Assets[name]
	local inst
	if asset then
		inst = Instance.new("ImageLabel")
		inst.Image = asset
		inst.ScaleType = Enum.ScaleType.Stretch
		inst.BackgroundTransparency = 1
	elseif name == "ring" then
		inst = Instance.new("Frame")
		inst.BackgroundTransparency = 1
		local st = Instance.new("UIStroke")
		st.Thickness = 2
		st.Parent = inst
		Instance.new("UICorner", inst).CornerRadius = UDim.new(1, 0)
	else
		inst = Instance.new("Frame")
		inst.BackgroundTransparency = 0
		Instance.new("UICorner", inst).CornerRadius = UDim.new(1, 0)
	end
	inst.BorderSizePixel = 0
	inst.AnchorPoint = Vector2.new(0.5, 0.5)
	inst.Active = false
	inst.Parent = parent
	return inst
end

local function fxSet(inst, v)
	if inst:IsA("ImageLabel") then
		inst.ImageTransparency = v
	else
		local st = inst:FindFirstChildOfClass("UIStroke")
		if st then st.Transparency = v else inst.BackgroundTransparency = v end
	end
end

local function fxFade(inst, v, time, style, dir)
	if inst:IsA("ImageLabel") then
		return tween(inst, { ImageTransparency = v }, time, style, dir)
	end
	local st = inst:FindFirstChildOfClass("UIStroke")
	if st then return tween(st, { Transparency = v }, time, style, dir) end
	return tween(inst, { BackgroundTransparency = v }, time, style, dir)
end

local function fxTint(inst, c)
	if inst:IsA("ImageLabel") then
		inst.ImageColor3 = c
	else
		local st = inst:FindFirstChildOfClass("UIStroke")
		if st then st.Color = c else inst.BackgroundColor3 = c end
	end
end

local function life(inst, t, layer)
	FX.Active += 1
	task.delay(t, function()
		FX.Active -= 1
		pcall(function() inst:Destroy() end)
		if layer and layer.Parent and layer.Name == "FxLayer" and #layer:GetChildren() <= 1 then
			layer.Visible = false
		end
	end)
end

local function layerOf(host, radius)
	local l = host:FindFirstChild("FxLayer")
	if not l then
		l = Instance.new("CanvasGroup")
		l.Name = "FxLayer"
		l.BackgroundTransparency = 1
		l.BorderSizePixel = 0
		l.Size = UDim2.fromScale(1, 1)
		l.ZIndex = 0
		l.Active = false
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, radius or 8)
		c.Parent = l
		l.Parent = host
	end
	l.Visible = true
	return l
end

function FX.ripple(host, pos, color, opts)
	if not fxOn() or not host or not host.Parent then return end
	opts = opts or {}
	local layer = host:IsA("CanvasGroup") and host or layerOf(host, opts.Radius or 8)
	local s = uiScale(layer)
	local ap, as = layer.AbsolutePosition, layer.AbsoluteSize
	if as.X <= 0 or as.Y <= 0 or s <= 0 then return end
	local w, h = as.X / s, as.Y / s
	local lx = pos and (pos.X - ap.X) / s or w / 2
	local ly = pos and (pos.Y - ap.Y) / s or h / 2
	lx, ly = math.clamp(lx, 0, w), math.clamp(ly, 0, h)
	local far = math.sqrt(math.max(lx, w - lx) ^ 2 + math.max(ly, h - ly) ^ 2)
	local d = math.max(far * 2.3, 24)
	local inst = fxShape("glow", layer)
	inst.ZIndex = 0
	inst.Position = UDim2.fromOffset(lx, ly)
	inst.Size = UDim2.fromOffset(d * 0.12, d * 0.12)
	fxTint(inst, color or Theme.Accent)
	fxSet(inst, opts.Alpha or 0.7)
	local t = opts.Time or 0.6
	life(inst, t + 0.05, layer)
	tween(inst, { Size = UDim2.fromOffset(d, d) }, t, Enum.EasingStyle.Quart)
	fxFade(inst, 1, t, Enum.EasingStyle.Quad)
end

function FX.shine(host, color, radius)
	if not fxOn() or not host or not host.Parent then return end
	local layer = host:IsA("CanvasGroup") and host or layerOf(host, radius or 8)
	local s = uiScale(layer)
	if s <= 0 or layer.AbsoluteSize.X <= 0 then return end
	local w, h = layer.AbsoluteSize.X / s, layer.AbsoluteSize.Y / s
	local bar = Instance.new("Frame")
	bar.BorderSizePixel = 0
	bar.AnchorPoint = Vector2.new(0.5, 0.5)
	bar.BackgroundColor3 = color or Color3.new(1, 1, 1)
	bar.Size = UDim2.fromOffset(h * 0.9, h * 3)
	bar.Rotation = 18
	bar.Position = UDim2.fromOffset(-h, h / 2)
	bar.ZIndex = 0
	local g = Instance.new("UIGradient")
	g.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.55), NumberSequenceKeypoint.new(1, 1),
	})
	g.Parent = bar
	bar.Parent = layer
	life(bar, 0.65, layer)
	tween(bar, { Position = UDim2.fromOffset(w + h, h / 2) }, 0.55, Enum.EasingStyle.Quint)
end

function FX.ring(center, color, from, to, time, a0)
	if not fxOn() then return end
	local inst = fxShape("ring", FxLayer)
	local ox, oy = FxLayer.AbsolutePosition.X, FxLayer.AbsolutePosition.Y
	inst.Position = UDim2.fromOffset(center.X - ox, center.Y - oy)
	inst.Size = UDim2.fromOffset(from, from)
	fxTint(inst, color)
	fxSet(inst, a0 or 0.3)
	time = time or 0.5
	life(inst, time + 0.05)
	tween(inst, { Size = UDim2.fromOffset(to, to) }, time, Enum.EasingStyle.Quint)
	fxFade(inst, 1, time, Enum.EasingStyle.Quad)
end

function FX.burst(center, color, count, dist, opts)
	if not fxOn() then return end
	opts = opts or {}
	count = math.min(count, FX.MAX - FX.Active)
	if count <= 0 then return end
	local base = opts.Base or (math.random() * math.pi * 2)
	local ox, oy = FxLayer.AbsolutePosition.X, FxLayer.AbsolutePosition.Y
	for k = 1, count do
		local ang = base + (k - 1) / count * math.pi * 2 + (math.random() - 0.5) * 0.7
		local d = dist * (0.6 + math.random() * 0.7)
		local sz = (opts.Size or 9) * (0.7 + math.random() * 0.6)
		local inst = fxShape(opts.Shape or "spark", FxLayer)
		inst.Position = UDim2.fromOffset(center.X - ox, center.Y - oy)
		inst.Size = UDim2.fromOffset(sz, sz)
		inst.Rotation = math.random(0, 90)
		fxTint(inst, (k % 3 == 0) and Theme.Text or color)
		fxSet(inst, 0)
		local t = 0.45 + math.random() * 0.25
		life(inst, t + 0.05)
		tween(inst, {
			Position = UDim2.fromOffset(center.X - ox + math.cos(ang) * d, center.Y - oy + math.sin(ang) * d * (opts.Squash or 1)),
			Size = UDim2.fromOffset(sz * 0.3, sz * 0.3),
			Rotation = inst.Rotation + (math.random() - 0.5) * 220,
		}, t, Enum.EasingStyle.Quint)
		task.delay(t * 0.3, function()
			if inst.Parent then fxFade(inst, 1, t * 0.7, Enum.EasingStyle.Quad) end
		end)
	end
end

local function fxScale(obj)
	local u = obj:FindFirstChild("FxScale")
	if not u then
		u = Instance.new("UIScale")
		u.Name = "FxScale"
		u.Parent = obj
	end
	return u
end

function FX.scaleTo(obj, v, time, style, dir)
	return tween(fxScale(obj), { Scale = v }, time or 0.2, style or Enum.EasingStyle.Quint, dir)
end

function FX.pop(obj, from, time)
	local u = fxScale(obj)
	u.Scale = from
	tween(u, { Scale = 1 }, time or 0.45, Enum.EasingStyle.Back)
end

local function flashObj(obj, prop, hot, rest, up, down)
	if Library.Effects == false then return end
	up = up or 0.08
	tween(obj, { [prop] = hot }, up, Enum.EasingStyle.Quad)
	task.delay(up, function()
		if obj.Parent then tween(obj, { [prop] = rest() }, down or 0.5, Enum.EasingStyle.Quad) end
	end)
end

local function pressTrack(hit, onDown, onUp)
	local st = { Pos = nil, Down = false }
	connect(hit.InputBegan, function(i)
		if i.UserInputType ~= Enum.UserInputType.MouseButton1 and i.UserInputType ~= Enum.UserInputType.Touch then return end
		st.Pos = Vector2.new(i.Position.X, i.Position.Y)
		st.Down = true
		if onDown then onDown(st.Pos) end
		local con
		con = i.Changed:Connect(function()
			if i.UserInputState == Enum.UserInputState.End or i.UserInputState == Enum.UserInputState.Cancel then
				con:Disconnect()
				st.Down = false
				if onUp then onUp() end
			end
		end)
	end)
	return st
end

function Library:SetEffects(v)
	Library.Effects = v and true or false
end

local function clampCenter(target, nx, ny, startPos)
	local vp = Gui.AbsoluteSize
	local w, h = target.AbsoluteSize.X, target.AbsoluteSize.Y
	local visX, visY = math.min(80, w), math.min(40, h)
	local bx, by = startPos.X.Scale * vp.X, startPos.Y.Scale * vp.Y
	local loX, hiX = visX - w / 2 - bx, vp.X + w / 2 - visX - bx
	local loY, hiY = h / 2 - by, vp.Y - visY + h / 2 - by
	if loX > hiX then loX = (loX + hiX) / 2 hiX = loX end
	if loY > hiY then loY = (loY + hiY) / 2 hiY = loY end
	return math.clamp(nx, loX, hiX), math.clamp(ny, loY, hiY)
end

local function draggable(handle, target, onTap, opt)
	opt = opt or {}
	local dragging, moved, startIn, startPos = false, false, nil, nil
	connect(handle.InputBegan, function(i)
		if i.UserInputType ~= Enum.UserInputType.MouseButton1 and i.UserInputType ~= Enum.UserInputType.Touch then return end
		if opt.canDrag and not opt.canDrag() then return end
		if opt.deadRight then
			local right = handle.AbsolutePosition.X + handle.AbsoluteSize.X
			if i.Position.X > right - opt.deadRight * getScale() then return end
		end
		dragging, moved = true, false
		startIn, startPos = i.Position, target.Position
		local con
		con = i.Changed:Connect(function()
			if i.UserInputState == Enum.UserInputState.End then
				dragging = false
				con:Disconnect()
				if onTap and not moved then onTap() end
			end
		end)
	end)
	connect(UserInputService.InputChanged, function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - startIn
			if not moved and d.Magnitude > DRAG_SLOP then
				moved = true
				closePopup()
			end
			if moved or not onTap then
				local nx, ny = clampCenter(target, startPos.X.Offset + d.X, startPos.Y.Offset + d.Y, startPos)
				target.Position = UDim2.new(startPos.X.Scale, nx, startPos.Y.Scale, ny)
			end
		end
	end)
end

function Library:SetTheme(name) applyTheme(name, false) end

function Library:SetTransparency(v)
	Library.Transparency = v
	for _, f in ipairs(TransFrames) do tween(f, { BackgroundTransparency = v }, 0.25) end
end

local function textWidth(text, size, font)
	local ok, sz = pcall(function()
		return TextService:GetTextSize(tostring(text), size, font or FONT, Vector2.new(10000, 100))
	end)
	if ok and sz then return sz.X end
	return #tostring(text) * size * 0.6
end

local function fitLine(lbl, maxSize, minSize, inset, fixedW)
	lbl.TextWrapped = false
	lbl.TextYAlignment = Enum.TextYAlignment.Center
	lbl.TextTruncate = Enum.TextTruncate.AtEnd
	local function refit()
		local w = fixedW or (lbl.AbsoluteSize.X / math.max(getScale(), 0.01))
		w = w - (inset or 0) - 2
		if w <= 4 then return end
		local size = maxSize
		while size > minSize and textWidth(lbl.Text, size, lbl.Font) > w do
			size -= 1
		end
		if lbl.TextSize ~= size then lbl.TextSize = size end
	end
	connect(lbl:GetPropertyChangedSignal("AbsoluteSize"), refit)
	connect(lbl:GetPropertyChangedSignal("Text"), refit)
	task.defer(refit)
	return refit
end

------------------------------------------------------------------------
-- DESIGN SYSTEM ("Kit")
-- Every floating surface (toast, dialog, popup, tooltip) is built from the
-- same pieces so nothing looks like it came from a different library:
--   surface : slab base + face + tone glow + top highlight + stroke + shadow
--   badge   : 3D coin with icon          tag : mono caps label
--   key     : 3D button with hint pill   tone: one shared semantic palette
-- Inline controls (rows, tiles, section cards) stay flat on purpose.
------------------------------------------------------------------------
local Kit = {
	Radius = { Tooltip = 8, Popup = 10, Toast = 12, Dialog = 16 },
	Thick = { Tooltip = 3, Popup = 4, Toast = 5, Dialog = 8 },
	Z = { Popup = 50, Toast = 90, Dialog = 100, Tooltip = 150 },
	White = Color3.new(1, 1, 1),
	Black = Color3.new(0, 0, 0),
	Tones = {
		info = { Color = Color3.fromRGB(96, 165, 250), Icon = "info", Label = "INFO" },
		success = { Color = Color3.fromRGB(64, 196, 108), Icon = "check", Label = "SUCCESS" },
		warning = { Color = Color3.fromRGB(242, 178, 44), Icon = "warning", Label = "WARNING" },
		error = { Color = Color3.fromRGB(228, 70, 80), Icon = "close", Label = "ERROR" },
	},
	Alias = { ok = "success", warn = "warning", err = "error", danger = "error", fail = "error" },
	Tips = {},
}
Library.Kit = Kit
Library.Tones = Kit.Tones

-- returns color, icon, label, isTone  (no tone -> live theme accent)
function Kit.tone(name)
	local key = name ~= nil and string.lower(tostring(name)) or nil
	if key and Kit.Alias[key] then key = Kit.Alias[key] end
	local t = key and Kit.Tones[key]
	if t then return t.Color, t.Icon, t.Label, true end
	return Theme.Accent, "info", "NOTICE", false
end

function Kit.onColor(c)
	if (c.R * 0.299 + c.G * 0.587 + c.B * 0.114) > 0.55 then return Color3.fromRGB(10, 18, 10) end
	return Kit.White
end

-- click/tap helper that does not leak connections into Library.Connections
function Kit.click(btn, fn, eager)
	local last = 0
	local function fire(pos)
		local now = os.clock()
		if now - last < 0.06 then return end
		last = now
		fn(pos)
	end
	btn.InputBegan:Connect(function(i)
		local t = i.UserInputType
		local p0 = Vector2.new(i.Position.X, i.Position.Y)
		if t == Enum.UserInputType.MouseButton1 then
			fire(p0)
		elseif t == Enum.UserInputType.Touch then
			if eager then
				fire(p0)
				return
			end
			local start = i.Position
			local con
			con = i.Changed:Connect(function()
				local st = i.UserInputState
				if st == Enum.UserInputState.End then
					con:Disconnect()
					if (i.Position - start).Magnitude <= TAP_SLOP then fire(p0) end
				elseif st == Enum.UserInputState.Cancel then
					con:Disconnect()
				end
			end)
		end
	end)
end

-- floating surface -----------------------------------------------------
-- o: Name Size Position AnchorPoint ZIndex Radius Thick Tone(Color3|nil) Glow
--    Canvas(bool: CanvasGroup face, fadeable) Clip(bool) Sink(bool) Shadow(false|table)
-- returns { Root, Base, Box, Face, Stroke, Shadow, GlowFrame, Outline }
function Kit.surface(parent, o)
	o = o or {}
	local r = o.Radius or Kit.Radius.Popup
	local T = o.Thick or Kit.Thick.Popup
	local tone = o.Tone
	local root = new("Frame", {
		Name = o.Name or "Surface", AnchorPoint = o.AnchorPoint or Vector2.new(0, 0), Position = o.Position or UDim2.new(),
		Size = o.Size or UDim2.fromOffset(200, 100), ZIndex = o.ZIndex or 1, LayoutOrder = o.LayoutOrder or 0, Parent = parent,
	})
	local s = { Root = root, Thick = T, Radius = r, Tone = tone }
	if o.Shadow ~= false then
		local sh = type(o.Shadow) == "table" and o.Shadow or { Steps = 3, Step = 4, Alpha = 0.07, Offset = T + 2 }
		s.Shadow = makeShadow(root, r, sh)
	end
	s.Base = new("Frame", {
		Name = "Base", Position = UDim2.fromOffset(0, T), Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = (tone or Theme.Accent):Lerp(Kit.Black, 0.62), ZIndex = 1, Parent = root,
	})
	corner(s.Base, r)
	s.Box = new("Frame", { Name = "Box", Size = UDim2.fromScale(1, 1), ZIndex = 3, Parent = root })
	s.Face = new(o.Canvas and "CanvasGroup" or "Frame", {
		Name = "Face", Size = UDim2.fromScale(1, 1), Bg = "Card", ClipsDescendants = o.Clip == true, Parent = s.Box,
	})
	if o.Sink then s.Face.Active = true end
	corner(s.Face, r)
	gradient(s.Face, 225)
	local glowProps = {
		Name = "Glow", Size = UDim2.fromScale(1, 1), BackgroundTransparency = o.Glow or 0.82, ZIndex = 1, Parent = s.Face,
	}
	if tone then glowProps.BackgroundColor3 = tone else glowProps.Bg = "Accent" end
	s.GlowFrame = new("Frame", glowProps)
	corner(s.GlowFrame, r)
	new("UIGradient", { Transparency = NumberSequence.new(0, 1), Rotation = 20, Parent = s.GlowFrame })
	new("Frame", {
		Name = "Highlight", Position = UDim2.fromOffset(r, 1), Size = UDim2.new(1, -r * 2, 0, 1),
		BackgroundColor3 = Kit.White, BackgroundTransparency = 0.9, Parent = s.Face,
	})
	if o.Canvas then
		s.Outline = new("Frame", { Name = "Outline", Size = UDim2.fromScale(1, 1), ZIndex = 4, Active = false, Parent = s.Box })
		corner(s.Outline, r)
		s.Stroke = stroke(s.Outline)
	else
		s.Stroke = stroke(s.Face)
	end
	return s
end

-- 3D coin badge: returns holder (center anchored), face, icon ----------
function Kit.badge(parent, icon, color, size, props)
	size = size or 32
	local edge = math.max(3, math.floor(size * 0.09))
	local holder = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(size, size + edge), Parent = parent,
	})
	if props then
		for k, v in pairs(props) do holder[k] = v end
	end
	local e = new("Frame", {
		Name = "Edge", Position = UDim2.fromOffset(0, edge), Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = color:Lerp(Kit.Black, 0.5), Parent = holder,
	})
	round(e)
	local f = new("Frame", { Name = "Coin", Size = UDim2.fromOffset(size, size), BackgroundColor3 = color, ZIndex = 2, Parent = holder })
	round(f)
	if size >= 40 then stroke(f, "Card", 2) end
	local ic = makeIcon(f, icon, math.floor(size * 0.5), nil, {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 3,
	})
	tintIcon(ic, Kit.onColor(color), 0.01)
	return holder, f, ic
end

-- mono caps label --------------------------------------------------------
function Kit.tag(parent, text, color, props)
	local p = {
		Text = string.upper(tostring(text)), Font = Enum.Font.Code, TextSize = 10, Size = UDim2.new(1, 0, 0, 12),
		TextTruncate = Enum.TextTruncate.AtEnd, Parent = parent,
	}
	if props then
		for k, v in pairs(props) do p[k] = v end
	end
	if color then p.TextColor3 = color:Lerp(Theme.Text, 0.3) else p.Fg = "SubText" end
	return new("TextLabel", p)
end

-- dotted separator -------------------------------------------------------
function Kit.perf(parent, x, y, w)
	local okC, cw = pcall(function()
		return TextService:GetTextSize("- ", 10, Enum.Font.Code, Vector2.new(1000, 20)).X
	end)
	local unit = (okC and cw and cw > 0) and cw or 11
	return new("TextLabel", {
		Text = string.rep("- ", math.floor(w / unit)), Font = Enum.Font.Code, TextSize = 10, Fg = "SubText", TextTransparency = 0.55,
		TextWrapped = false, ClipsDescendants = true, Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, 12), Parent = parent,
	})
end

-- 3D key button ------------------------------------------------------------
-- o: Text W H Radius Thick TextSize Variant("neutral"|"primary") Color(Color3) Hint Position ZIndex
function Kit.key(parent, o)
	local W, H, r, T = o.W or 96, o.H or 38, o.Radius or 11, o.Thick or 4
	local neutral = o.Variant == "neutral"
	local tone = o.Color
	local holder = new("Frame", {
		Name = o.Name or "Key", Position = o.Position or UDim2.new(), Size = UDim2.fromOffset(W, H + T),
		ZIndex = o.ZIndex or 1, LayoutOrder = o.LayoutOrder or 0, Parent = parent,
	})
	local key = { Holder = holder, Enabled = true }
	local function rest()
		if neutral then return Theme.Element end
		return tone or Theme.Accent
	end
	local function over()
		if neutral then return Theme.Hover end
		return rest():Lerp(Kit.White, 0.14)
	end
	local base = new("Frame", {
		Name = "Base", Position = UDim2.fromOffset(0, T), Size = UDim2.fromOffset(W, H),
		BackgroundColor3 = rest():Lerp(Kit.Black, 0.5), Parent = holder,
	})
	corner(base, r)
	local fp = { Name = "Face", Size = UDim2.fromOffset(W, H), ZIndex = 2, Parent = holder }
	if neutral then fp.Bg = "Element" elseif tone then fp.BackgroundColor3 = tone else fp.Bg = "Accent" end
	local face = new("TextButton", fp)
	corner(face, r)
	if neutral then stroke(face) end
	key.Face = face

	local hint = o.Hint
	local avail = W - 16 - (hint and 44 or 0)
	local text = tostring(o.Text or "")
	local size = o.TextSize or 13
	while size > 10 and textWidth(text, size, FONT_BOLD) > avail do size -= 1 end
	local lp = {
		Name = "Label", Text = text, Font = FONT_BOLD, TextSize = size, TextXAlignment = Enum.TextXAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(8, 0), Size = UDim2.fromOffset(avail, H), Parent = face,
	}
	if neutral then lp.Fg = "Text" elseif tone then lp.TextColor3 = Kit.onColor(tone) else lp.Fg = "AccentText" end
	local label = new("TextLabel", lp)
	key.Label = label

	if hint then
		local hintCol = neutral and Theme.Text or (tone and Kit.onColor(tone) or Theme.AccentText)
		local pill = new("TextLabel", {
			Name = "Hint", Text = hint, Font = Enum.Font.Code, TextSize = 9, TextColor3 = hintCol, TextTransparency = 0.2,
			BackgroundColor3 = Kit.Black, BackgroundTransparency = 0.8, AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(0, 16), AutomaticSize = AutoX,
			TextXAlignment = Enum.TextXAlignment.Center, Parent = face,
		})
		corner(pill, 5)
		padding(pill, 5, 0, 5, 0)
	end

	local hov = false
	local function lift(y, t, style)
		tween(face, { Position = UDim2.fromOffset(0, y) }, t, style or Enum.EasingStyle.Quint)
	end
	face.MouseEnter:Connect(function()
		if not key.Enabled then return end
		hov = true
		lift(-1, 0.12)
		tween(face, { BackgroundColor3 = over() }, 0.15)
	end)
	face.MouseLeave:Connect(function()
		hov = false
		lift(0, 0.16)
		tween(face, { BackgroundColor3 = rest() }, 0.2)
	end)
	face.MouseButton1Down:Connect(function()
		if key.Enabled then lift(T - 1, 0.05, Enum.EasingStyle.Quad) end
	end)
	face.MouseButton1Up:Connect(function() lift(hov and -1 or 0, 0.24, Enum.EasingStyle.Back) end)

	function key:SetEnabled(v)
		self.Enabled = v and true or false
		tween(face, { BackgroundTransparency = self.Enabled and 0 or 0.6 }, 0.15)
		tween(label, { TextTransparency = self.Enabled and 0 or 0.6 }, 0.15)
	end
	function key:SetText(t) label.Text = tostring(t) end
	function key:OnClick(fn)
		Kit.click(face, function(pos)
			if not self.Enabled then return end
			FX.ripple(face, pos, neutral and Theme.Accent or Kit.White, { Radius = r, Alpha = 0.65, Time = 0.4 })
			fn(pos)
		end, true)
	end
	return key
end

-- Esc closes the open popup (dropdown / color picker)
connect(UserInputService.InputBegan, function(i)
	if i.KeyCode == Enum.KeyCode.Escape and Library.OpenPopup and not Library._confirm then
		closePopup()
	end
end)

------------------------------------------------------------------------
-- TOOLTIPS: any element accepts Tooltip = "text" (and TooltipTitle)
-- Library:AddTooltip(guiObject, text, title) works on custom GUI too.
------------------------------------------------------------------------
Library.TooltipsEnabled = true
function Library:SetTooltips(v) Library.TooltipsEnabled = v and true or false end

function Kit.addTip(gui, text, title)
	if not gui or text == nil or tostring(text) == "" then return end
	Kit.Tips[#Kit.Tips + 1] = { Gui = gui, Text = tostring(text), Title = title ~= nil and tostring(title) or nil }
end
function Library:AddTooltip(gui, text, title) Kit.addTip(gui, text, title) end

do
	local DELAY = 0.45
	local cur, since, shown = nil, 0, nil
	local touch = nil
	local linger = 0

	local function hide(fast)
		local s = shown
		if not s then return end
		shown = nil
		tween(s.Face, { GroupTransparency = 1 }, fast and 0.05 or 0.12)
		tween(s.Stroke, { Transparency = 1 }, fast and 0.05 or 0.12)
		tween(s.Base, { BackgroundTransparency = 1 }, fast and 0.05 or 0.12)
		if s.Shadow then s.Shadow:Fade(false, 0.1) end
		task.delay(0.16, function() pcall(function() s.Root:Destroy() end) end)
	end

	local function show(tip, p)
		hide(true)
		local scale = getScale()
		local T = Kit.Thick.Tooltip
		local okT, sz = pcall(function()
			return TextService:GetTextSize(tip.Text, 12, FONT, Vector2.new(210, 10000))
		end)
		local tw = (okT and sz) and math.ceil(sz.X) or math.min(210, #tip.Text * 7)
		local th = (okT and sz) and math.ceil(sz.Y) or 15
		local titleW = tip.Title and math.ceil(textWidth(tip.Title, 12, FONT_BOLD)) or 0
		local W = math.clamp(math.max(tw, titleW) + 28, 80, 240)
		local y0 = 10
		local H = y0 + (tip.Title and 18 or 0) + th + 10
		local vp = Gui.AbsoluteSize
		local x = math.min(p.X + 14, vp.X - W * scale - 8)
		local y = p.Y + (IS_TOUCH and -(H + T) * scale - 28 or 20)
		if y + (H + T) * scale > vp.Y - 8 then y = p.Y - (H + T) * scale - 12 end
		x, y = math.max(8, x), math.max(8, y)
		local s = Kit.surface(Gui, {
			Name = "Tooltip", Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(W, H), ZIndex = Kit.Z.Tooltip,
			Radius = Kit.Radius.Tooltip, Thick = T, Canvas = true, Glow = 0.9,
			Shadow = { Steps = 3, Step = 3, Alpha = 0.06, Offset = 4 },
		})
		new("UIScale", { Scale = scale, Parent = s.Root })
		local face = s.Face
		if tip.Title then
			new("TextLabel", {
				Text = tip.Title, Font = FONT_BOLD, TextSize = 12, Fg = "Text", Position = UDim2.fromOffset(14, y0),
				Size = UDim2.new(1, -28, 0, 16), TextTruncate = Enum.TextTruncate.AtEnd, Parent = face,
			})
		end
		new("TextLabel", {
			Text = tip.Text, TextSize = 12, Fg = "SubText", TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.fromOffset(14, y0 + (tip.Title and 18 or 0)), Size = UDim2.fromOffset(W - 28, th), Parent = face,
		})
		face.GroupTransparency = 1
		s.Stroke.Transparency = 1
		s.Base.BackgroundTransparency = 1
		if s.Shadow then s.Shadow:Set(false) end
		tween(face, { GroupTransparency = 0 }, 0.14)
		tween(s.Stroke, { Transparency = 0 }, 0.14)
		tween(s.Base, { BackgroundTransparency = 0 }, 0.14)
		if s.Shadow then s.Shadow:Fade(true, 0.2) end
		shown = s
	end

	local function visibleAt(g, p)
		local o = g
		while o and o ~= Gui do
			if o:IsA("GuiObject") then
				if not o.Visible then return false end
				if o ~= g and o.ClipsDescendants then
					local ap, as = o.AbsolutePosition, o.AbsoluteSize
					if p.X < ap.X or p.X > ap.X + as.X or p.Y < ap.Y or p.Y > ap.Y + as.Y then return false end
				end
			end
			o = o.Parent
		end
		return o == Gui
	end

	connect(UserInputService.InputBegan, function(i)
		if i.UserInputType ~= Enum.UserInputType.Touch then return end
		local p = toScreen(i.Position)
		touch = { pos = p, start = p, t = os.clock(), input = i }
		linger = 0
	end)
	connect(UserInputService.InputChanged, function(i)
		if touch and i == touch.input then
			local p = toScreen(i.Position)
			touch.pos = p
			if (p - touch.start).Magnitude > 14 and not shown then touch.moved = true end
		end
	end)
	connect(UserInputService.InputEnded, function(i)
		if touch and i == touch.input then
			touch = nil
			if shown then linger = 2.2 else cur = nil end
		end
	end)

	local acc = 0
	connect(RunService.Heartbeat, function(dt)
		acc += dt
		if acc < 0.06 then return end
		local step = acc
		acc = 0
		if #Kit.Tips == 0 then return end
		local win = Library.Windows[1]
		if not Library.TooltipsEnabled or not (win and win.Visible) or Library.OpenPopup or Library._confirm or SliderLock.Active then
			hide()
			cur, since = nil, 0
			return
		end
		local p
		if IS_TOUCH then
			if touch and not touch.moved then
				p = touch.pos
			elseif linger > 0 then
				linger -= step
				if linger <= 0 then
					hide()
					cur = nil
				end
				return
			else
				hide()
				cur, since = nil, 0
				return
			end
		else
			p = UserInputService:GetMouseLocation()
		end
		local found
		for i = #Kit.Tips, 1, -1 do
			local t = Kit.Tips[i]
			local g = t.Gui
			if not g.Parent then
				table.remove(Kit.Tips, i)
			elseif not found then
				local ap, as = g.AbsolutePosition, g.AbsoluteSize
				if p.X >= ap.X and p.X <= ap.X + as.X and p.Y >= ap.Y and p.Y <= ap.Y + as.Y and visibleAt(g, p) then
					found = t
				end
			end
		end
		if found ~= cur then
			cur = found
			since = 0
			hide()
		elseif found then
			since += step
			if not shown and since >= DELAY then show(found, p) end
		end
	end)
end

------------------------------------------------------------------------
-- NOTIFICATIONS
-- Library:Notify({
--   Title, Content, Type = "info"|"success"|"warning"|"error", Icon, Tag,
--   Duration = 4 (Persistent = true stays), Actions = { {Text, Callback, Primary, Keep} },
--   Progress = 0..1 | true (indeterminate), Id = "key" (update in place),
--   Stack = false (disable duplicate merging), OnClick = function, Important = true
-- }) -> handle { Dismiss(), Update({...}), SetProgress(v), Id }
------------------------------------------------------------------------
do
	local NOTIFY_W, NOTIFY_OFF = 292, 380
	local TEXT_X = 58
	local TEXT_W = NOTIFY_W - TEXT_X - 16
	local THICK = Kit.Thick.Toast
	local RAD = Kit.Radius.Toast
	local WHITE, BLACK = Kit.White, Kit.Black

	local PLACES = {
		BottomRight = { anchor = Vector2.new(1, 1), pos = UDim2.new(1, -16, 1, -20), h = Enum.HorizontalAlignment.Right, v = Enum.VerticalAlignment.Bottom, dx = 1, dy = 0, order = 1 },
		BottomLeft = { anchor = Vector2.new(0, 1), pos = UDim2.new(0, 16, 1, -20), h = Enum.HorizontalAlignment.Left, v = Enum.VerticalAlignment.Bottom, dx = -1, dy = 0, order = 1 },
		BottomCenter = { anchor = Vector2.new(0.5, 1), pos = UDim2.new(0.5, 0, 1, -20), h = Enum.HorizontalAlignment.Center, v = Enum.VerticalAlignment.Bottom, dx = 0, dy = 1, order = 1 },
		TopRight = { anchor = Vector2.new(1, 0), pos = UDim2.new(1, -16, 0, 20), h = Enum.HorizontalAlignment.Right, v = Enum.VerticalAlignment.Top, dx = 1, dy = 0, order = -1 },
		TopLeft = { anchor = Vector2.new(0, 0), pos = UDim2.new(0, 16, 0, 20), h = Enum.HorizontalAlignment.Left, v = Enum.VerticalAlignment.Top, dx = -1, dy = 0, order = -1 },
		TopCenter = { anchor = Vector2.new(0.5, 0), pos = UDim2.new(0.5, 0, 0, 78), h = Enum.HorizontalAlignment.Center, v = Enum.VerticalAlignment.Top, dx = 0, dy = -1, order = -1 },
	}
	Library.NotifyPlaces = { "BottomRight", "BottomLeft", "BottomCenter", "TopRight", "TopLeft", "TopCenter" }
	Library.NotifyPosition = "BottomRight"
	Library.NotifyMax = 4
	Library.NotifyQuiet = false
	Library.NotifyHistory = {}
	Library.NotifyListeners = {}

	local holder = new("Frame", {
		Name = "Notifications", Size = UDim2.fromOffset(NOTIFY_W, 520), ZIndex = Kit.Z.Toast, Parent = Gui,
	})
	local list = new("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder, Parent = holder })

	local function place() return PLACES[Library.NotifyPosition] or PLACES.BottomRight end
	local function applyPlace()
		local p = place()
		holder.AnchorPoint = p.anchor
		holder.Position = p.pos
		list.VerticalAlignment = p.v
		list.HorizontalAlignment = p.h
	end
	applyPlace()

	function Library:SetNotifyPosition(name)
		if not PLACES[name] then return end
		Library.NotifyPosition = name
		applyPlace()
	end
	function Library:SetNotifyMax(n) Library.NotifyMax = math.clamp(math.floor(tonumber(n) or 4), 1, 8) end
	function Library:SetNotifyQuiet(v) Library.NotifyQuiet = v and true or false end

	local toasts, serial = {}, 0

	function Library:ClearNotifications()
		for i = #toasts, 1, -1 do
			local t = toasts[i]
			if t then t.Dismiss() end
		end
	end

	local function spr(s, target, dt)
		s.v += ((target - s.x) * 150 - s.v * 17) * dt
		s.x += s.v * dt
	end

	local function bodyHeight(txt)
		if txt == "" then return 0 end
		local okS, sz = pcall(function()
			return TextService:GetTextSize(txt, 12, FONT, Vector2.new(TEXT_W, 10000))
		end)
		return (okS and sz) and (math.ceil(sz.Y) + 2) or (math.ceil(#txt / 32) * 15 + 2)
	end

	local function restack()
		local n = #toasts
		local p = place()
		for i, e in ipairs(toasts) do
			local depth = n - i
			if p.order < 0 then depth = i - 1 end
			e.depth = depth
			if not e.dead and e.dim then
				tween(e.dim, { BackgroundTransparency = e.hover and 1 or (1 - math.min(depth * 0.1, 0.3)) }, 0.25)
				if e.ready and not e.hover then
					tween(e.mover, { Position = UDim2.fromOffset(depth * 3 * (p.dx == 0 and 1 or p.dx), 0) }, 0.35, Enum.EasingStyle.Back)
				end
			end
		end
	end

	local function record(o, label)
		local entry = {
			Time = os.time(), Title = tostring(o.Title or "Notification"), Content = tostring(o.Content or ""),
			Type = string.lower(label or "info"),
		}
		local h = Library.NotifyHistory
		h[#h + 1] = entry
		if #h > 100 then table.remove(h, 1) end
		for _, fn in ipairs(Library.NotifyListeners) do pcall(fn, entry) end
	end

	local NOOP = { Dismiss = function() end, Update = function() end, SetProgress = function() end }

	function Library:Notify(o)
		if type(o) ~= "table" then o = { Content = tostring(o or "") } end
		local color, tIcon, tLabel, isTone = Kit.tone(o.Type)
		record(o, isTone and tLabel or "info")

		if o.Id then
			for _, e in ipairs(toasts) do
				if e.id == o.Id and not e.dead then
					e.handle:Update(o)
					return e.handle
				end
			end
		end

		local dur = o.Persistent and 0 or (tonumber(o.Duration) or 4)
		if Library.NotifyQuiet and dur ~= 0 and not o.Important and not (tLabel == "WARNING" or tLabel == "ERROR") then
			return NOOP
		end

		local actions = {}
		for _, a in ipairs(type(o.Actions) == "table" and o.Actions or {}) do
			if #actions < 3 and type(a) == "table" then actions[#actions + 1] = a end
		end
		local hasProgress = o.Progress ~= nil
		local sig = tostring(o.Type) .. "|" .. tostring(o.Title) .. "|" .. tostring(o.Content)
		if o.Stack ~= false and #actions == 0 and not hasProgress then
			for _, e in ipairs(toasts) do
				if e.sig == sig and not e.dead then
					e.bump(dur)
					return e.handle
				end
			end
		end

		while #toasts >= math.max(1, Library.NotifyMax or 4) do toasts[1].Dismiss() end
		serial += 1

		local P = place()
		local tone = isTone and color or nil
		local icon = o.Icon or tIcon
		local tagText = string.upper(tostring(o.Tag or (isTone and tLabel) or "Notice"))
		local title = tostring(o.Title or "Notification")
		local body = tostring(o.Content or "")
		local bodyH = bodyHeight(body)
		local H, progY, actY = 62, nil, nil
		local function compute()
			local cb = bodyH > 0 and (46 + bodyH) or 43
			progY, actY = nil, nil
			if hasProgress then
				progY = cb + 8
				cb = progY + 4
			end
			if #actions > 0 then
				actY = cb + 10
				cb = actY + 30
			end
			H = math.max(62, cb + 14)
		end
		compute()

		local offIn = UDim2.fromOffset(P.dx * NOTIFY_OFF, P.dy * 70)
		local slot = new("Frame", { Size = UDim2.new(1, 0, 0, 0), LayoutOrder = serial * P.order, Parent = holder })
		local surf = Kit.surface(slot, {
			Name = "Toast", Size = UDim2.new(1, 0, 0, H), Position = offIn, Radius = RAD, Thick = THICK, Tone = tone,
			Shadow = { Steps = 3, Step = 4, Alpha = 0.07, Offset = 7 },
		})
		local mover, box, face, baseF = surf.Root, surf.Box, surf.Face, surf.Base
		mover.Rotation = 6 * (P.dx == 0 and 1 or P.dx)

		local timeProps = { Name = "Timer", Position = UDim2.fromOffset(0, THICK), Size = UDim2.new(1, 0, 0, H), ZIndex = 2, Parent = mover }
		if tone then timeProps.BackgroundColor3 = tone else timeProps.Bg = "Accent" end
		local timeBar = new("Frame", timeProps)
		corner(timeBar, RAD)

		local tagLbl = Kit.tag(face, tagText, tone, {
			Position = UDim2.fromOffset(TEXT_X, 13), Size = UDim2.fromOffset(TEXT_W - 36, 12),
		})
		local titleLbl = new("TextLabel", {
			Text = title, Font = FONT_BOLD, TextSize = 14, Fg = "Text", Position = UDim2.fromOffset(TEXT_X, 25),
			Size = UDim2.fromOffset(TEXT_W, 18), TextTruncate = Enum.TextTruncate.AtEnd, Parent = face,
		})
		local function fitTitle()
			local ts = 14
			while ts > 11 and textWidth(titleLbl.Text, ts, FONT_BOLD) > TEXT_W - 2 do ts -= 1 end
			titleLbl.TextSize = ts
		end
		fitTitle()
		local bodyLbl = new("TextLabel", {
			Text = body, Fg = "SubText", TextSize = 12, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.fromOffset(TEXT_X, 46), Size = UDim2.fromOffset(TEXT_W, math.max(bodyH, 1)), Visible = bodyH > 0, Parent = face,
		})
		local metaLbl = new("TextLabel", {
			Text = "", Font = Enum.Font.Code, TextSize = 10, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 13),
			Size = UDim2.fromOffset(40, 12), TextXAlignment = Enum.TextXAlignment.Right, Visible = false, Parent = face,
		})
		if tone then metaLbl.TextColor3 = tone:Lerp(Theme.Text, 0.3) else bind(metaLbl, "TextColor3", "Accent") end

		local circleCol = tone or Theme.Accent
		local badge, bFace, bIcon = Kit.badge(face, icon, circleCol, 32, { Position = UDim2.fromOffset(30, 31) })

		local track, fill, fillLoop
		local function setProgress(v)
			if not fill then return end
			if fillLoop then
				pcall(function() fillLoop:Cancel() end)
				fillLoop = nil
			end
			if v == true then
				fill.Size = UDim2.fromScale(0.3, 1)
				fill.Position = UDim2.fromScale(0, 0)
				fillLoop = TweenService:Create(fill, TweenInfo.new(1.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Position = UDim2.fromScale(0.7, 0) })
				fillLoop:Play()
				metaLbl.Visible = false
			else
				local f = math.clamp(tonumber(v) or 0, 0, 1)
				fill.Position = UDim2.fromScale(0, 0)
				tween(fill, { Size = UDim2.fromScale(f, 1) }, 0.25, Enum.EasingStyle.Quad)
				metaLbl.Text = string.format("%d%%", math.floor(f * 100 + 0.5))
				metaLbl.Visible = true
			end
		end
		if hasProgress then
			track = new("Frame", {
				Name = "Track", Position = UDim2.fromOffset(TEXT_X, progY), Size = UDim2.fromOffset(TEXT_W, 4), Bg = "Stroke", Parent = face,
			})
			round(track)
			local fp = { Name = "Fill", Size = UDim2.fromScale(0, 1), Parent = track }
			if tone then fp.BackgroundColor3 = tone else fp.Bg = "Accent" end
			fill = new("Frame", fp)
			round(fill)
		end

		local entry = {
			mover = mover, dim = nil, depth = 0, dead = false, hover = false, ready = false,
			id = o.Id, sig = sig, count = 1,
		}
		local hoverN = 0
		local st = { hover = false, press = false }
		local sx, sy, sl = { x = 0, v = 0 }, { x = 0, v = 0 }, { x = 0, v = 0 }
		local fillTw, loop
		local dismiss, startTimer
		local handle = {}

		local dim = new("Frame", {
			Name = "Dim", Size = UDim2.new(1, 0, 0, H), BackgroundColor3 = BLACK, BackgroundTransparency = 1, ZIndex = 5, Parent = mover,
		})
		corner(dim, RAD)
		entry.dim = dim
		local hit = new("TextButton", {
			Name = "Tap", Size = UDim2.new(1, 0, 0, actY and (actY - 2) or H), ZIndex = 6, Parent = mover,
		})

		local keys = {}
		if #actions > 0 then
			local gap = 8
			local widths, total = {}, 0
			for i, a in ipairs(actions) do
				widths[i] = math.clamp(math.ceil(textWidth(tostring(a.Text or "OK"), 11, FONT_BOLD)) + 28, 58, 130)
				total += widths[i]
			end
			total += gap * (#actions - 1)
			local k = total > TEXT_W and (TEXT_W - gap * (#actions - 1)) / (total - gap * (#actions - 1)) or 1
			local x = TEXT_X
			for i, a in ipairs(actions) do
				local w = math.floor(widths[i] * k)
				local key = Kit.key(face, {
					Name = "Action" .. i, Text = tostring(a.Text or "OK"), W = w, H = 26, Radius = 8, Thick = 4, TextSize = 11,
					Variant = (a.Primary or (i == #actions and #actions == 1)) and "primary" or "neutral", Color = a.Primary and tone or nil,
					Position = UDim2.fromOffset(x, actY),
				})
				key:OnClick(function()
					if a.Callback then task.spawn(a.Callback, handle) end
					if not a.Keep then dismiss() end
				end)
				key.Face.MouseEnter:Connect(function()
					if entry.dead then return end
					hoverN += 1
					entry.hover = true
					if fillTw then fillTw:Pause() end
				end)
				key.Face.MouseLeave:Connect(function()
					if entry.dead then return end
					hoverN = math.max(0, hoverN - 1)
					if hoverN == 0 then
						entry.hover = false
						if fillTw then fillTw:Play() end
					end
				end)
				keys[i] = key
				x += w + gap
			end
		end

		local function layout(animate)
			compute()
			mover.Size = UDim2.new(1, 0, 0, H)
			dim.Size = UDim2.new(1, 0, 0, H)
			hit.Size = UDim2.new(1, 0, 0, actY and (actY - 2) or H)
			if track then track.Position = UDim2.fromOffset(TEXT_X, progY) end
			for _, key in ipairs(keys) do
				key.Holder.Position = UDim2.fromOffset(key.Holder.Position.X.Offset, actY)
			end
			if fillTw == nil then timeBar.Size = UDim2.new(1, 0, 0, H) end
			if animate then
				tween(slot, { Size = UDim2.new(1, 0, 0, H + THICK) }, 0.25, Enum.EasingStyle.Quint)
			end
		end
		layout(false)

		local function wake()
			if loop or entry.dead or not entry.ready then return end
			loop = RunService.RenderStepped:Connect(function(dt)
				if entry.dead or not face.Parent then
					if loop then loop:Disconnect() loop = nil end
					return
				end
				dt = math.min(dt, 1 / 20)
				local tx, ty, tl = 0, 0, 0
				if st.press then
					tl = THICK - 1
				elseif st.hover then
					local m = UserInputService:GetMouseLocation()
					local ap, as = mover.AbsolutePosition, mover.AbsoluteSize
					if as.X > 0 and as.Y > 0 then
						tx = math.clamp((m.X - (ap.X + as.X / 2)) / (as.X / 2), -1, 1)
						ty = math.clamp((m.Y - (ap.Y + as.Y / 2)) / (as.Y / 2), -1, 1)
					end
					tl = -2
				end
				spr(sx, tx, dt)
				spr(sy, ty, dt)
				spr(sl, tl, dt)
				box.Position = UDim2.fromOffset(snap(-sx.x * 3, 0.5), snap(sl.x - sy.x * 1.5, 0.5))
				local bx, by = snap(sx.x * 2.5, 0.5), THICK + snap(sy.x * 1.5, 0.5)
				baseF.Position = UDim2.fromOffset(bx, by)
				timeBar.Position = UDim2.fromOffset(bx, by)
				if not (st.hover or st.press)
					and math.abs(sx.x) + math.abs(sy.x) + math.abs(sl.x) + math.abs(sx.v) + math.abs(sy.v) + math.abs(sl.v) < 0.01 then
					box.Position = UDim2.new()
					baseF.Position = UDim2.fromOffset(0, THICK)
					timeBar.Position = UDim2.fromOffset(0, THICK)
					sx.x, sx.v, sy.x, sy.v, sl.x, sl.v = 0, 0, 0, 0, 0, 0
					loop:Disconnect()
					loop = nil
				end
			end)
		end

		function dismiss()
			if entry.dead then return end
			entry.dead = true
			if fillTw then pcall(function() fillTw:Cancel() end) end
			if fillLoop then pcall(function() fillLoop:Cancel() end) end
			if loop then loop:Disconnect() loop = nil end
			hit.Active = false
			hit.Visible = false
			for i = #toasts, 1, -1 do
				if toasts[i] == entry then table.remove(toasts, i) end
			end
			restack()
			tween(box, { Position = UDim2.fromOffset(0, THICK - 1) }, 0.06, Enum.EasingStyle.Quad)
			task.delay(0.07, function()
				if not mover.Parent then return end
				tween(box, { Position = UDim2.fromOffset(26 * (P.dx == 0 and 1 or P.dx), THICK - 1) }, 0.26, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
				tween(mover, { Position = offIn, Rotation = -5 * (P.dx == 0 and 1 or P.dx) }, 0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
			end)
			task.delay(0.36, function()
				if not slot.Parent then return end
				tween(slot, { Size = UDim2.new(1, 0, 0, 0) }, 0.2, Enum.EasingStyle.Quint)
				task.delay(0.22, function()
					if slot.Parent then slot:Destroy() end
					prune()
				end)
			end)
		end
		entry.Dismiss = dismiss

		function startTimer(seconds)
			if fillTw then
				pcall(function() fillTw:Cancel() end)
				fillTw = nil
			end
			timeBar.Size = UDim2.new(1, 0, 0, H)
			if seconds and seconds > 0 then
				fillTw = TweenService:Create(timeBar, TweenInfo.new(seconds, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, H) })
				local mine = fillTw
				mine.Completed:Connect(function(state)
					if state == Enum.PlaybackState.Completed and fillTw == mine then dismiss() end
				end)
				mine:Play()
				if entry.hover then mine:Pause() end
			end
		end

		hit.InputBegan:Connect(function(i)
			local ty = i.UserInputType
			if ty ~= Enum.UserInputType.MouseButton1 and ty ~= Enum.UserInputType.Touch then return end
			if entry.dead then return end
			st.press = true
			wake()
			local p0 = i.Position
			local con
			con = i.Changed:Connect(function()
				local s = i.UserInputState
				if s == Enum.UserInputState.End or s == Enum.UserInputState.Cancel then
					con:Disconnect()
					st.press = false
					if s == Enum.UserInputState.End and not entry.dead and (i.Position - p0).Magnitude <= TAP_SLOP then
						if o.OnClick then task.spawn(o.OnClick, handle) end
						dismiss()
					else
						wake()
					end
				end
			end)
		end)
		if not IS_TOUCH then
			hit.MouseEnter:Connect(function()
				if entry.dead then return end
				hoverN += 1
				entry.hover, st.hover = true, true
				if fillTw then fillTw:Pause() end
				tween(dim, { BackgroundTransparency = 1 }, 0.15)
				wake()
			end)
			hit.MouseLeave:Connect(function()
				if entry.dead then return end
				hoverN = math.max(0, hoverN - 1)
				st.hover = false
				if hoverN == 0 then
					entry.hover = false
					if fillTw then fillTw:Play() end
				end
				restack()
				wake()
			end)
		end

		local function recolor(typeName)
			local c, ic, lbl, tn = Kit.tone(typeName)
			local newTone = tn and c or nil
			local col = newTone or Theme.Accent
			bFace.BackgroundColor3 = col
			badge.Edge.BackgroundColor3 = col:Lerp(BLACK, 0.5)
			tintIcon(bIcon, Kit.onColor(col), 0.01)
			timeBar.BackgroundColor3 = col
			surf.GlowFrame.BackgroundColor3 = col
			baseF.BackgroundColor3 = col:Lerp(BLACK, 0.62)
			if fill then fill.BackgroundColor3 = col end
			tagLbl.TextColor3 = newTone and newTone:Lerp(Theme.Text, 0.3) or Theme.SubText
			metaLbl.TextColor3 = newTone and newTone:Lerp(Theme.Text, 0.3) or Theme.Accent
			if tn then tagLbl.Text = lbl end
			return ic
		end

		function handle:Dismiss() dismiss() end
		function handle:SetProgress(v) setProgress(v) end
		function handle:Update(u)
			if entry.dead or type(u) ~= "table" then return end
			local relayout = false
			if u.Title ~= nil then
				titleLbl.Text = tostring(u.Title)
				fitTitle()
			end
			if u.Content ~= nil then
				body = tostring(u.Content)
				bodyLbl.Text = body
				local nh = bodyHeight(body)
				if nh ~= bodyH then
					bodyH = nh
					bodyLbl.Size = UDim2.fromOffset(TEXT_W, math.max(bodyH, 1))
					relayout = true
				end
				bodyLbl.Visible = bodyH > 0
			end
			if u.Type ~= nil then
				local ic = recolor(u.Type)
				if u.Icon == nil and ic then
					local entryIcon = Icons[ic]
					if entryIcon then
						bIcon.Image = entryIcon[1]
						local g = bIcon:FindFirstChild("Glyph")
						if g then g.Text = entryIcon[2] end
					end
				end
			end
			if u.Tag ~= nil then tagLbl.Text = string.upper(tostring(u.Tag)) end
			if u.Progress ~= nil then setProgress(u.Progress) end
			if relayout then layout(true) end
			if u.Duration ~= nil or u.Persistent ~= nil then
				startTimer(u.Persistent and 0 or tonumber(u.Duration) or 4)
			elseif u.Content ~= nil or u.Title ~= nil then
				if fillTw then startTimer(tonumber(o.Duration) or 4) end
			end
			FX.pop(badge, 0.8, 0.3)
		end
		handle.Id = o.Id
		entry.handle = handle

		function entry.bump(seconds)
			entry.count += 1
			metaLbl.Text = "x" .. entry.count
			metaLbl.Visible = true
			FX.pop(metaLbl, 1.4, 0.35)
			FX.pop(badge, 0.75, 0.3)
			if entry.ready then startTimer(seconds) end
		end

		table.insert(toasts, entry)
		restack()
		tween(slot, { Size = UDim2.new(1, 0, 0, H + THICK) }, 0.38, Enum.EasingStyle.Quint)
		box.Position = UDim2.fromOffset(0, -9)
		tween(mover, { Position = UDim2.new(), Rotation = 0 }, 0.55, Enum.EasingStyle.Back)
		local edgeCol = tone or Theme.Accent
		surf.Stroke.Color = edgeCol
		tween(surf.Stroke, { Color = Theme.Stroke }, 1.0, Enum.EasingStyle.Quad)
		task.delay(0.24, function()
			if entry.dead or not face.Parent then return end
			tween(box, { Position = UDim2.new() }, 0.42, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out)
			badge.Rotation = -30
			tween(badge, { Rotation = 0 }, 0.5, Enum.EasingStyle.Back)
			FX.pop(badge, 0.5, 0.5)
		end)
		task.delay(0.7, function()
			if entry.dead then return end
			entry.ready = true
			restack()
			if st.hover or st.press then wake() end
		end)

		if hasProgress then setProgress(o.Progress) end
		startTimer(dur)
		return handle
	end
end

function Library:ListConfigs()
	local list = {}
	if not (HasFS and listfiles) then return list end
	local dir = Library.ConfigFolder .. "/configs"
	if not isfolder(dir) then return list end
	for _, p in ipairs(listfiles(dir)) do
		local n = tostring(p):match("([^/\\]+)%.json$")
		if n then list[#list + 1] = n end
	end
	table.sort(list)
	return list
end

function Library:SaveConfig(name)
	if not HasFS then return false end
	name = tostring(name or ""):gsub("[^%w_%- ]", "")
	if name:gsub("%s", "") == "" then return false end
	ensureFolder(ROOT)
	ensureFolder(Library.ConfigFolder)
	ensureFolder(Library.ConfigFolder .. "/configs")
	local data = {}
	for flag, obj in pairs(Library.Options) do
		local v = obj.Value
		if v ~= nil then
			if typeof(v) == "EnumItem" then
				v = { __key = v.Name }
			elseif typeof(v) == "Color3" then
				v = { __c3 = v:ToHex() }
			end
			data[flag] = v
		end
	end
	local ok = pcall(function()
		writefile(Library.ConfigFolder .. "/configs/" .. name .. ".json", HttpService:JSONEncode(data))
		writefile(Library.ConfigFolder .. "/last.txt", name)
	end)
	return ok, name
end

function Library:LoadConfig(name)
	if not HasFS or not name then return false end
	local path = Library.ConfigFolder .. "/configs/" .. name .. ".json"
	if not isfile(path) then return false end
	local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
	if not ok or type(data) ~= "table" then return false end
	for flag, v in pairs(data) do
		local obj = Library.Options[flag]
		if obj then
			pcall(function()
				if type(v) == "table" and v.__key then
					v = Enum.KeyCode[v.__key]
				elseif type(v) == "table" and v.__c3 then
					v = Color3.fromHex(v.__c3)
				end
				obj:Set(v)
			end)
		end
	end
	pcall(writefile, Library.ConfigFolder .. "/last.txt", name)
	return true
end

function Library:Unload()
	if SliderLock.Active then pcall(SliderLock.Active) end
	for _, c in ipairs(Library.Connections) do pcall(function() c:Disconnect() end) end
	Library.Connections = {}
	pcall(function() Gui:Destroy() end)
	env.__ZystrixUI = nil
end

local Section = {}
Section.__index = Section

function Section:_next()
	self.Order += 1
	return self.Order
end

local function register(obj, o)
	obj.Flag = o.Flag
	if o.Flag then
		Library.Options[o.Flag] = obj
		Library.Flags[o.Flag] = obj.Value
	end
end

local function fire(obj, o)
	if obj.Flag then Library.Flags[obj.Flag] = obj.Value end
	if o.Callback then task.spawn(o.Callback, obj.Value) end
	if obj.Flag and Library.OnFlagChanged then task.spawn(Library.OnFlagChanged, obj.Flag, obj.Value) end
end

local function quiet(obj)
	if obj.Flag then Library.Flags[obj.Flag] = obj.Value end
end

local function makeRow(sec, height, bgKey)
	local row = new("Frame", { Size = UDim2.new(1, 0, 0, height or 36), Bg = bgKey or "Element", LayoutOrder = sec:_next(), Parent = sec.Content })
	corner(row, 8)
	return row
end

local function indexItem(sec, name, kind, row, icon, o)
	if o and o.Tooltip then Kit.addTip(row, o.Tooltip, o.TooltipTitle) end
	local tab = sec.Tab
	local win = tab and tab.Window
	if win and win._register then
		win:_register({ Name = name, Kind = kind, Tab = tab, Section = sec, Row = row, Icon = icon })
	end
end

local function fitLabel(lbl, size, height)
	lbl.TextSize = size
	lbl.TextTruncate = Enum.TextTruncate.AtEnd
	lbl.TextWrapped = height >= 30
end

local function rowLabel(row, text, width, shift)
	shift = shift or 0
	width = width or UDim2.new(1, -24, 1, 0)
	local lbl = new("TextLabel", {
		Text = text or "", Fg = "Text", Position = UDim2.fromOffset(12 + shift, 0),
		Size = UDim2.new(width.X.Scale, width.X.Offset - shift - 12, width.Y.Scale, width.Y.Offset),
		TextTruncate = Enum.TextTruncate.AtEnd, Parent = row,
	})
	fitLine(lbl, 13, 9)
	return lbl
end

local function rowIcon(row, spec, cy)
	if not spec then return 0 end
	local pos = cy and UDim2.new(0, 12, 0, cy) or UDim2.new(0, 12, 0.5, 0)
	makeIcon(row, spec, 16, "SubText", { AnchorPoint = Vector2.new(0, 0.5), Position = pos })
	return 26
end

local function onHover(gui, enter, leave)
	if IS_TOUCH then return end
	connect(gui.MouseEnter, enter)
	connect(gui.MouseLeave, leave)
end

function onClick(btn, fn, eager)
	local last = 0
	local function fire(pos)
		local now = os.clock()
		if now - last < 0.06 then return end
		last = now
		fn(pos)
	end
	connect(btn.InputBegan, function(i)
		local t = i.UserInputType
		local p0 = Vector2.new(i.Position.X, i.Position.Y)
		if t == Enum.UserInputType.MouseButton1 then
			fire(p0)
		elseif t == Enum.UserInputType.Touch then
			if eager then
				fire(p0)
				return
			end
			local start = i.Position
			local con
			con = i.Changed:Connect(function()
				local st = i.UserInputState
				if st == Enum.UserInputState.End then
					con:Disconnect()
					if (i.Position - start).Magnitude <= TAP_SLOP then fire(p0) end
				elseif st == Enum.UserInputState.Cancel then
					con:Disconnect()
				end
			end)
		end
	end)
end
